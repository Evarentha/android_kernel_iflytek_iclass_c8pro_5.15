/*
 * iclass-c8pro hardware description; included in place from the board DTS.
 * Copyright (C) 2026 Evarentha - Linux 5.15 board port changes.
 */

		aon {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			eic_debounce: gpio@32000000 {
				compatible = "sprd,roc1-eic-debounce";
				reg = <0x00 0x32000000 0x00 0x80 0x00 0x32010000 0x00 0x80 0x00 0x32020000 0x00 0x80 0x00 0x32030000 0x00 0x80 0x00 0x32230000 0x00 0x80 0x00 0x32270000 0x00 0x80>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x157>;
			};

			eic_latch: gpio@32000080 {
				compatible = "sprd,roc1-eic-latch";
				reg = <0x00 0x32000080 0x00 0x20 0x00 0x32010080 0x00 0x20 0x00 0x32020080 0x00 0x20 0x00 0x32030080 0x00 0x20 0x00 0x32230080 0x00 0x20 0x00 0x32270080 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x158>;
			};

			eic_async: gpio@320000a0 {
				compatible = "sprd,roc1-eic-async";
				reg = <0x00 0x320000a0 0x00 0x20 0x00 0x320100a0 0x00 0x20 0x00 0x320200a0 0x00 0x20 0x00 0x320300a0 0x00 0x20 0x00 0x322300a0 0x00 0x20 0x00 0x322700a0 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x35>;
			};

			eic_sync: gpio@320000c0 {
				compatible = "sprd,roc1-eic-sync";
				reg = <0x00 0x320000c0 0x00 0x20 0x00 0x320100c0 0x00 0x20 0x00 0x320200c0 0x00 0x20 0x00 0x320300c0 0x00 0x20 0x00 0x322300c0 0x00 0x20 0x00 0x322700c0 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x159>;
			};

			timer@32050000 {
				compatible = "sprd,roc1-timer";
				reg = <0x00 0x32050000 0x00 0x20>;
				interrupts = <0x00 0x47 0x04>;
				clocks = <0x25>;
			};

			timer@32050020 {
				compatible = "sprd,roc1-suspend-timer";
				reg = <0x00 0x32050020 0x00 0x20>;
				clocks = <0x25>;
			};

			aon_i2c0: i2c@32060000 {
				compatible = "sprd,roc1-hw-i2c";
				reg = <0x00 0x32060000 0x00 0x1000>;
				interrupts = <0x00 0x44 0x04>;
				clock-names = "source", "enable", "i2c";
				clocks = <&ext_26m>, <&aonapb_gate 0x2c>,
					 <&aon_clk 0x11>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				phandle = <0x15a>;

				cpudvfs-dcdc-cpu1@62 {
					compatible = "sprd,cpudvfs-regulator-dcdc-cpu1-roc1";
					reg = <0x62>;
					dvfs-dcdc-i2c = <0x01>;
				};
			};

			ap_gpio: gpio@32070000 {
				compatible = "sprd,roc1-gpio";
				reg = <0x00 0x32070000 0x00 0x10000>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x3d 0x04>;
				phandle = <0x2d>;
			};

			ap_thm0: thermal@32200000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32200000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x28>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x3b 0x3c>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10c>;

				core6a7-big@0 {
					reg = <0x00>;
					nvmem-cells = <0x3d>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core4-big@1 {
					reg = <0x01>;
					nvmem-cells = <0x3e>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core5-big@2 {
					reg = <0x02>;
					nvmem-cells = <0x3f>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core6-big@3 {
					reg = <0x03>;
					nvmem-cells = <0x40>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core7-big@4 {
					reg = <0x04>;
					nvmem-cells = <0x41>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm1: thermal@32210000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32210000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x29>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x42 0x43>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10d>;

				ai0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x44>;
					nvmem-cell-names = "sen_delta_cal";
				};

				ai1-sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x45>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm2: thermal@32220000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32220000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x2a>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x46 0x47>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10e>;

				gpu0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x48>;
					nvmem-cell-names = "sen_delta_cal";
				};

				mm-sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x49>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm3: thermal@32520000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32520000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x23>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x4a 0x4b>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10f>;

				cputop0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x4c>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core0-little@1 {
					reg = <0x01>;
					nvmem-cells = <0x4d>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core1-little@2 {
					reg = <0x02>;
					nvmem-cells = <0x4e>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core2-little@3 {
					reg = <0x03>;
					nvmem-cells = <0x4f>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core3-little@4 {
					reg = <0x04>;
					nvmem-cells = <0x50>;
					nvmem-cell-names = "sen_delta_cal";
				};

				cputop1-sensor@5 {
					reg = <0x05>;
					nvmem-cells = <0x51>;
					nvmem-cell-names = "sen_delta_cal";
				};

				gpu1-sensor@6 {
					reg = <0x06>;
					nvmem-cells = <0x52>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			cluster0_sensor: cluster0-sensor@15 {
				compatible = "sprd,cluster0-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "littlecore0-thmzone", "littlecore1-thmzone", "littlecore2-thmzone", "littlecore3-thmzone";
				k-po = <0x80>;
				k-pu = <0x100>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x2710>;
				phandle = <0x110>;
			};

			cluster1_sensor: cluster1-sensor@16 {
				compatible = "sprd,cluster1-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "bigcore4-thmzone", "bigcore5-thmzone", "bigcore6-thmzone", "bigcore7-thmzone";
				k-po = <0x80>;
				k-pu = <0x100>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x2710>;
				phandle = <0x111>;
			};

			soc_sensor: soc-sensor@17 {
				compatible = "sprd,soc-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "cluster0-thmzone", "cluster1-thmzone";
				k-po = <0x00>;
				k-pu = <0x00>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x00>;
				phandle = <0x108>;
			};

			ap_efuse: efuse@32240000 {
				compatible = "sprd,roc1-efuse";
				reg = <0x00 0x32240000 0x00 0x10000>;
				clock-names = "enable";
				hwlocks = <0x53 0x08>;
				clocks = <0x04 0x13>;
				phandle = <0x15b>;

				thm0_sign: thm0-sign@8c {
					reg = <0x8c 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x3b>;
				};

				thm0_ratio: thm0-ratio@8c {
					reg = <0x8c 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x3c>;
				};

				thm0_sen0: thm0-sen0@8c {
					reg = <0x8d 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3d>;
				};

				thm0_sen1: thm0-sen1@94 {
					reg = <0x95 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3e>;
				};

				thm0_sen2: thm0-sen2@94 {
					reg = <0x94 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3f>;
				};

				thm0_sen3: thm0-sen3@97 {
					reg = <0x97 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x40>;
				};

				thm0_sen4: thm0-sen4@96 {
					reg = <0x96 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x41>;
				};

				thm1_sign: thm1-sign@90 {
					reg = <0x90 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x42>;
				};

				thm1_ratio: thm1-ratio@90 {
					reg = <0x90 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x43>;
				};

				thm1_sen0: thm1-sen0@91 {
					reg = <0x91 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x44>;
				};

				thm1_sen1: thm1-sen1@99 {
					reg = <0x99 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x45>;
				};

				thm2_sign: thm2-sign@92 {
					reg = <0x92 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x46>;
				};

				thm2_ratio: thm2-ratio@92 {
					reg = <0x92 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x47>;
				};

				thm2_sen0: thm2-sen0@93 {
					reg = <0x93 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x48>;
				};

				thm2_sen1: thm2-sen0@98 {
					reg = <0x98 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x49>;
				};

				thm3_sign: thm3-sign@6c {
					reg = <0x6c 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x4a>;
				};

				thm3_ratio: thm3-ratio@6c {
					reg = <0x6c 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x4b>;
				};

				thm3_sen0: thm3-sen0@6c {
					reg = <0x6d 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x4c>;
				};

				thm3_sen1: thm3-sen1@9b {
					reg = <0x9b 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x4d>;
				};

				thm3_sen2: thm3-sen2@9a {
					reg = <0x9a 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x4e>;
				};

				thm3_sen3: thm3-sen3@69 {
					reg = <0x69 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x4f>;
				};

				thm3_sen4: thm3-sen4@68 {
					reg = <0x68 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x50>;
				};

				thm3_sen5: thm3-sen5@6b {
					reg = <0x6b 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x51>;
				};

				thm3_sen6: thm3-sen6@6a {
					reg = <0x6a 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x52>;
				};

				lit_bin: lit-bin@79 {
					reg = <0x79 0x01>;
					bits = <0x00 0x04>;
					phandle = <0xeb>;
				};

				big_bin: big-bin@79 {
					reg = <0x79 0x01>;
					bits = <0x04 0x04>;
					phandle = <0xec>;
				};

				scu_bin: scu-bin@7b {
					reg = <0x7b 0x01>;
					bits = <0x04 0x04>;
					phandle = <0xed>;
				};
			};

			topdvfs_controller: topdvfsctrl@322A0000 {
				compatible = "sprd,roc1-topdvfs", "syscon";
				sprd,syscon-enable = <0x10>;
				module-enable-cfg = <0x04 0x07>;
				reg = <0x00 0x322a0000 0x00 0x8000>;
				cpu-dcdc-cells = <0x54 0x55>;
				device-dcdc-cells = <0x56 0x57>;
				phandle = <0x60>;

				dcdc_cpu0: dcdc-cpu0 {
					dcdc-dvfs-enable = <0x90 0x00 0x01>;
					dcdc-judge-vol-sw = <0x150 0x0f 0x07 0x00>;
					dcdc-subsys-tune-enable = <0x300 0x02 0x01>;
					dcdc-supply-mode-cfg = <0x58>;
					sync-dcdc-idle-voltage;
					dcdc-idle-voltage = <0x320 0x06 0x07 0x05>;
					phandle = <0x54>;
				};

				dcdc_cpu1: dcdc-cpu1 {
					dcdc-dvfs-enable = <0xa0 0x00 0x01>;
					dcdc-judge-vol-sw = <0x160 0x0f 0x07 0x00>;
					dcdc-subsys-tune-enable = <0x300 0x01 0x01>;
					dcdc-supply-mode-cfg = <0x59>;
					sync-dcdc-idle-voltage;
					dcdc-idle-voltage = <0x320 0x03 0x07 0x05>;
					phandle = <0x55>;
				};

				dcdc_mm: dcdc-mm {
					dcdc-dvfs-enable = <0x18 0x14 0x01>;
					dcdc-judge-vol-sw = <0x18 0x01 0x07 0x02>;
					dcdc-subsys-cells = <0x5a 0x5b 0x5c>;
					phandle = <0x56>;

					audcp_sys: audcp-sys {
						dcdc-subsys-tune-enable = <0x300 0x06 0x01>;
						phandle = <0x5a>;
					};

					gpu_sys: gpu-sys {
						dcdc-subsys-tune-enable = <0x300 0x08 0x01>;
						phandle = <0x5b>;
					};

					mm_sys: mm-sys {
						dcdc-subsys-tune-enable = <0x300 0x07 0x01>;
						phandle = <0x5c>;
					};
				};

				dcdc_modem: dcdc-modem {
					dcdc-dvfs-enable = <0x48 0x14 0x01>;
					dcdc-judge-vol-sw = <0x48 0x01 0x07 0x02>;
					dcdc-subsys-cells = <0x5d 0x5e 0x5f>;
					phandle = <0x57>;

					pubcp_sys: pubcp-sys {
						dcdc-subsys-tune-enable = <0x300 0x03 0x00>;
						phandle = <0x5d>;
					};

					wtlcp_sys: wtlcp-sys {
						dcdc-subsys-tune-enable = <0x300 0x04 0x00>;
						phandle = <0x5e>;
					};

					ap_sys: ap-sys {
						dcdc-subsys-tune-enable = <0x300 0x05 0x01>;
						phandle = <0x5f>;
					};
				};
			};

			cpudvfs_dev: cpudvfs-dev@322A8000 {
				compatible = "sprd,roc1-cpudvfs";
				sprd,syscon-enable = <0x10>;
				module-enable-cfg = <0x04 0x07>;
				topdvfs-controller = <0x60>;
				reg = <0x00 0x322a8000 0x00 0x1000>;
				mpll-cells = <0x61 0x62 0x63>;
				apcpu-dvfs-dcdc-cells = <0x64 0x65>;
				cpudvfs-clusters = <0x66 0x67 0x68 0x69 0x6a>;
				phandle = <0x15c>;

				lit_core_cluster: lit-core-cluster {
					cluster-name = "lit-core-cluster";
					row-num = <0x10>;
					column-num = <0x07>;
					work-index-cfg = <0x214 0x0f>;
					idle-index-cfg = <0x218 0x0f>;
					tuning-latency-us = <0xc8>;
					tuning-result-judge = <0x00>;
					dcdc-name = "DCDC_CPU0";
					map-tbl-regs = <0x60 0x64 0x68 0x6c 0x70 0x74 0x78 0x7c 0x80 0x84 0x88 0x8c 0x90 0x94 0x98 0x9c>;
					column-entry-start-bit = <0x00 0x02 0x0f 0x05 0x09 0x12 0x0c>;
					column-entry-mask = <0x03 0x07 0x07 0x0f 0x07 0x07 0x07>;
					cluster-devices = <0x6b 0x6c 0x6d 0x6e>;
					lit-core-dvfs-tbl = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x01 0x00 0x01 0x01 0x01 0x00 0x01 0x00 0x00 0x01 0x01 0x01 0x00 0x03 0x00 0x01 0x02 0x01 0x01 0x00 0x03 0x00 0x02 0x03 0x02 0x02 0x01 0x02 0x00 0x03 0x04 0x02 0x02 0x00 0x03 0x00 0x04 0x05 0x02 0x03 0x02 0x03 0x00 0x05 0x06 0x02 0x03 0x03 0x03 0x00 0x06 0x07 0x02 0x03 0x04 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05 0x03 0x00 0x07 0x08 0x02 0x03 0x05>;

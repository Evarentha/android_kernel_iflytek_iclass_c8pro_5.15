	sprd_pcm_iis: sprd-pcm-iis {
		compatible = "sprd,sharkl5-pcm-platform";
		#sound-dai-cells = <0x00>;
		dmas = <0x116 0x05 0x116 0x06>;
		dma-names = "iis0_tx", "iis0_rx";
		sprd,dma-2stage-usecase = <0x02>;
		sprd,node-count-2stage-level-1 = <0x01>;
		sprd,syscon-pmu-apb = <0x02>;
		sprd,dma-2stage-level-1-int-source = <0x01>;
		phandle = <0x121>;
	};

	sound_sprd_ap_alliis: sound@1 {
		compatible = "sprd,i2s-null-codec";
		status = "disabled";
		sprd-audio-card,name = "all-i2s";
		phandle = <0x1ed>;

		sprd-audio-card,dai-link@0 {

			plat {
				sound-dai = <0x121>;
			};

			cpu {
				sound-dai = <0x122>;
			};

			codec {
				sound-dai = <0x00 0x00>;
			};
		};
	};


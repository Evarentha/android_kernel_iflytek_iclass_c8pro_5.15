	sprd_headset: sprd-headset {
		compatible = "sprd,headset";
		status = "okay";
		sprd,jack-type = <0x00>;
		io-channels = <0x2a 0x14>;
		io-channel-names = "headmic_in_little";
		gpios = <0x83 0x06 0x00>;
		sprd,debounce-interval = <0x0a>;
		gpio-names = "aud_int_all";
		sprd,3pole-adc-threshold = <0x70>;
		sprd,adc-gnd = <0x148>;
		sprd,half-adc-gnd = <0x64>;
		sprd,coefficient = <0xd7f28>;
		sprd,irq-threshold-button = <0x04>;
		nvmem-cells = <0x80 0x118>;
		nvmem-cell-names = "hp_adc_fir_calib", "hp_adc_sec_calib";
		extcon = <0x1c>;
		mic-gpios = <0x2d 0x8e 0x01>;
		lr-gpios = <0x2d 0x37 0x00>;
		switch-supply = <0x1b>;
		sprd,switch-voltage = <0x325aa0>;
		phandle = <0x119>;

		sprd,headset-button@0 {
			adc-min = <0x00>;
			adc-max = <0x1e0>;
			code = <0xe2>;
		};

		sprd,headset-button@1 {
			adc-min = <0x1e1>;
			adc-max = <0x3de>;
			code = <0x73>;
		};

		sprd,headset-button@2 {
			adc-min = <0x3df>;
			adc-max = <0x9c4>;
			code = <0x72>;
		};
	};

	sound_vbc_v4_sprd_codec: sound@0 {
		compatible = "sprd,vbc-v4-codec-sc2730";
		status = "okay";
		sprd-audio-card,name = "sprdphone-sc2730";
		sprd-audio-card,widgets = "Headphone", "inter HP PA", "Speaker", "inter Spk PA", "Speaker", "inter Ear PA";
		sprd-audio-card,routing = "HPMIC Pin", "HP Mic Jack", "MIC Pin", "Mic Jack", "MIC2 Pin", "Aux Mic Jack", "inter HP PA", "HP Pin", "inter Spk PA", "SPK Pin", "DMIC Pin", "DMic Jack", "DMIC1 Pin", "DMic1 Jack", "inter Ear PA", "EAR Pin";
		sprd-audio-card,headset = <0x119>;
		sprd,syscon-agcp-ahb = <0xa2>;
		phandle = <0x1ec>;

		sprd-audio-card,dai-link@0 {
			link-name = "FE_NORMAL_AP01";
			stream-name = "FE_ST_NORMAL_AP01";
			ignore-suspend = <0x00>;
			dynamic = <0x01>;
			trigger = <0x01 0x01>;
			dpcm-playback = <0x01>;
			dpcm-capture = <0x01>;
			be-id = <0x00>;

			plat {
				sound-dai = <0x11a>;
			};

			cpu {
				sound-dai = <0x11b 0x00>;
			};

			codec {
				sound-dai = <0x00 0x00>;

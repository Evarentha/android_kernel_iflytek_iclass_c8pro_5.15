	sipa_eth0: sipa-eth0 {
		compatible = "sprd,sipa_eth";
		sprd,netid = <0x01>;
		sprd,term-type = <0x06>;
		phandle = <0x1af>;
	};

	sipa_eth1: sipa-eth1 {
		compatible = "sprd,sipa_eth";
		sprd,netid = <0x02>;
		sprd,term-type = <0x06>;
		phandle = <0x1b0>;
	};

	sipa_eth2: sipa-eth2 {
		compatible = "sprd,sipa_eth";
		sprd,netid = <0x03>;
		sprd,term-type = <0x06>;
		phandle = <0x1b1>;
	};

	sipa_eth3: sipa-eth3 {

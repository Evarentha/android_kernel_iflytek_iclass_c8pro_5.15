		resistance-temp-table = <0x2d 0x64 0x19 0x64 0x0a 0x1e3 0x00 0x2a8 0xfffffff6 0x315 0xffffffec 0x330>;
		capacity-temp-table1 = <0x32 0x62 0x19 0x64 0x0a 0x64 0x00 0x60 0xfffffff6 0x55>;
		resistance-temp-table1 = <0x32 0x52 0x19 0x64 0x0a 0xbb 0x00 0x212 0xfffffff6 0x2f7>;
		charge-sdp-current-microamp = <0x7a120 0x7a120>;

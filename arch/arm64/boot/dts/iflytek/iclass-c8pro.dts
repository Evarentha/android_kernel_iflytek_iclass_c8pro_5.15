			};

			dcam: dcam@62900000 {
				compatible = "sprd,roc1-cam";
				reg = <0x00 0x62900000 0x00 0x1000 0x00 0x62901000 0x00 0x1000 0x00 0x62902000 0x00 0x1000 0x00 0x62903000 0x00 0x1000>;
				reg-names = "dcam0_reg", "dcam1_reg", "dcam2_reg", "axi_ctrl_reg";
				interrupts = <0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04>;
				interrupt-names = "dcam0", "dcam1", "dcam2";
				clock-names = "dcam_eb", "dcam_clk", "dcam_clk_192m", "dcam_clk_256m", "dcam_clk_307m2", "dcam_clk_384m", "dcam_clk_468m", "dcam_clk_parent", "dcam_axi_eb", "dcam_axi_clk", "dcam_axi_clk_256m", "dcam_axi_clk_307m2", "dcam_axi_clk_384m", "dcam_axi_clk_468m", "dcam_axi_clk_parent";
				clocks = <0x05 0x02 0x06 0x08 0x07 0x03 0x07 0x09 0x07 0x0c 0x07 0x02 0x07 0x1b 0x07 0x1b 0x05 0x11 0x06 0x09 0x07 0x09 0x07 0x0c 0x07 0x02 0x07 0x1b 0x07 0x1b>;
				syscons = <0x03 0x04 0x800000 0x03 0x04 0x20 0x03 0x04 0x10 0x03 0x04 0x08>;
				syscon-names = "dcam_all_reset", "dcam0_reset", "dcam1_reset", "dcam2_reset";
				sprd,cam-ahb-syscon = <0x03>;
				sprd,isp = <0x14>;
				sprd,dcam-count = <0x03>;
				sprd,project-id = <0x02>;
				iommus = <0x15>;
				status = "okay";
				phandle = <0x14c>;
			};

			iommu_dcam: iommu@62900000 {
				compatible = "unisoc,iommuexroc1-dcam";
				reg = <0x00 0x62900000 0x00 0xc000 0x00 0x6290c000 0x00 0x60>;
				iova-base = <0x50000000>;
				iova-size = <0x20000000>;
				reg_name = "mmu_interrupt_reg", "mmu_reg";
				status = "okay";
				#iommu-cells = <0x00>;
				phandle = <0x15>;
			};

			fd: fd@62a00000 {
				compatible = "sprd,fd";
				reg = <0x00 0x62a00000 0x00 0x100000>;
				interrupts = <0x00 0x8d 0x04>;
				interrupts_name = "fdraw";
				clock-names = "fd_eb", "fd_axi_eb", "fd_clk", "fd_clk_parent";
				clocks = <0x05 0x0a 0x05 0x03 0x06 0x07 0x07 0x02>;
				sprd,cam-ahb-syscon = <0x03>;
				status = "okay";
				phandle = <0x14d>;
			};
		};

		ipa-apb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			pam_ipa: pam-ipa@21140000 {
				compatible = "sprd,pam-ipa";
				reg = <0x00 0x21140000 0x00 0x100>;
				reg-names = "pam-ipa-base";
				syscons = <0x16 0x04 0x20>;
				syscon-names = "enable";
				power-domains = <0x17>;
				sprd,cp-ul-intr-to-ap = <0x00>;
				sprd,cp-ul-threshold = <0x01>;
				sprd,cp-ul-timeout = <0x05>;
				sprd,cp-ul-flowctrl-mode = <0x01>;
				sprd,cp-ul-enter-flowctrl-watermark = <0x10>;
				sprd,cp-ul-exit-flowctrl-watermark = <0x04>;
				sprd,cp-dl-intr-to-ap = <0x00>;
				sprd,cp-dl-threshold = <0x10>;
				sprd,cp-dl-timeout = <0x00>;
				sprd,cp-dl-flowctrl-mode = <0x00>;
				sprd,cp-dl-enter-flowctrl-watermark = <0x24>;
				sprd,cp-dl-exit-flowctrl-watermark = <0x04>;
				sprd,pam-ipa-hw-ver = <0x01>;
				sprd,pam-ipa-hw-mode = <0x00>;
				phandle = <0x14e>;
			};

			ipa_local: sipa@21180000 {
				compatible = "sprd,roc1-sipa";
				reg = <0x00 0x21180000 0x00 0x2000 0x00 0x20b10000 0x00 0x40000>;
				reg-names = "glb-base", "iram-base";
				interrupts = <0x00 0x8a 0x04>;
				interrupt-names = "local_ipa_irq";
				syscons = <0x16 0x04 0x08 0x02 0x25c 0xff>;
				syscon-names = "enable", "wakeup";
				power-domains = <0x17>;
				sprd,sipa-bypass-mode = <0x00>;
				sprd,need-through-pcie;
				sprd,wiap-ul-dma;
				sprd,usb-dl-tx = <0x00 0x800>;
				sprd,usb-dl-rx = <0x00 0x800>;
				sprd,usb-ul-tx = <0x00 0x800>;
				sprd,usb-ul-rx = <0x00 0x800>;
				sprd,cp-dl-tx = <0x00 0x1000>;
				sprd,cp-dl-rx = <0x00 0x1000>;
				sprd,cp-ul-tx = <0x00 0x1000>;
				sprd,cp-ul-rx = <0x00 0x1000>;
				sprd,wifi-dl-tx = <0x01 0x80>;
				sprd,wifi-dl-rx = <0x01 0x80>;
				sprd,wifi-ul-tx = <0x01 0x80>;
				sprd,wifi-ul-rx = <0x01 0x80>;
				sprd,ap-eth-dl-tx = <0x00 0x1000>;
				sprd,ap-eth-dl-rx = <0x00 0x1000>;
				sprd,ap-eth-ul-tx = <0x00 0x1000>;
				sprd,ap-eth-ul-rx = <0x00 0x1000>;
				sprd,ap-ip-dl-tx = <0x00 0x1000>;
				sprd,ap-ip-dl-rx = <0x00 0x1000>;
				sprd,ap-ip-ul-tx = <0x00 0x1000>;
				sprd,ap-ip-ul-rx = <0x00 0x1000>;
				phandle = <0x14f>;
			};

			ipa_delegate: sipa-dele@80000000 {
				compatible = "sprd,roc1-sipa-delegate";
				reg = <0x00 0x80000000 0x00 0x10000000 0x00 0x2e000000 0x00 0x10000>;
				reg-names = "mem-base", "reg-base";
				sprd,ul-fifo-depth = <0x1000>;
				sprd,dl-fifo-depth = <0x1000>;
				phandle = <0x150>;
			};
		};

		ap-ahb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			ap_dma: dma-controller@20000000 {
				compatible = "sprd,roc1-dma";
				reg = <0x00 0x20000000 0x00 0x4000>;
				interrupts = <0x00 0x18 0x04>;
				#dma-cells = <0x01>;
				#dma-channels = <0x1c>;
				clock-names = "enable";
				clocks = <0x18 0x04>;
				phandle = <0x116>;
			};

			hsphy: hsphy@20100000 {
				compatible = "sprd,roc1-phy";
				sprd,syscon-enable = <0x10>;
				sprd,syscon-anag3 = <0x19>;
				sprd,syscon-anatop = <0x1a>;
				sprd,syscon-pmu-apb = <0x02>;
				sprd,vdd-voltage = <0x325aa0>;
				#phy-cells = <0x00>;
				vdd-supply = <0x1b>;
				extcon = <0x1c>;
				status = "disabled";
				phandle = <0x7c>;
			};

			dpu: dpu@20300000 {
				compatible = "sprd,roc1-dpu";
				reg = <0x00 0x20300000 0x00 0x1000>;
				interrupts = <0x00 0x1b 0x04>;
				status = "okay";
				syscons = <0x1d 0x04 0x02 0x1d 0x148 0xff>;
				syscon-names = "reset", "qos";
				dma-coherent;
				iommus = <0x1e>;
				sprd,ip = "dpu-r3p0";
				sprd,soc = "roc1";
				sprd,qos = <0x1f>;
				sprd,wb-memory = <0x20>;
				clock-names = "clk_src_128m", "clk_src_153m6", "clk_src_192m", "clk_src_256m", "clk_src_307m2", "clk_src_384m", "clk_dpu_core", "clk_dpu_dpi", "clk_ap_ahb_disp_eb";
				clocks = <0x07 0x0a 0x07 0x0f 0x07 0x03 0x07 0x09 0x07 0x0c 0x07 0x02 0x21 0x18 0x21 0x19 0x18 0x01>;
				phandle = <0x151>;

				dpu_port: port {
					phandle = <0x106>;

					dpu_out: endpoint {
						remote-endpoint = <0x22>;
						phandle = <0x2c>;
					};
				};
			};

			gsp_core0: gsp@20300000 {
				compatible = "sprd,gsp-core";
				reg = <0x00 0x20300000 0x00 0x2000>;
				core-id = <0x00>;
				kcfg-num = <0x10>;
				interrupts = <0x00 0x1a 0x04>;
				iommus = <0x1e>;
				clock-names = "clk_dpu_core_src", "clk_dpu_core", "clk_ap_ahb_disp_eb";
				clocks = <0x07 0x02 0x21 0x18 0x18 0x01>;
				phandle = <0xee>;
			};

			iommu_dispc: iommu@20300000 {
				compatible = "unisoc,iommuexroc1-dispc";
				reg = <0x00 0x20300000 0x00 0x800 0x00 0x20300800 0x00 0x80>;
				iova-base = <0x30000000>;
				iova-size = <0x10000000>;
				reg_name = "mmu_interrupt_reg", "mmu_reg";
				status = "okay";
				#iommu-cells = <0x00>;
				phandle = <0x1e>;
			};

			ipa_intc: ipa@20e03000 {
				compatible = "sprd,ud710-ipa-intc";
				reg = <0x00 0x20e03000 0x00 0x1000>;
				interrupt-controller;
				interrupts = <0x00 0x92 0x04>;
				#interrupt-cells = <0x01>;
				syscon-names = "ipa_intc_eb";
				syscons = <0x16 0x04 0x1000>;
				phandle = <0x37>;
			};

			usb3: usb3@20f00000 {
				compatible = "sprd,roc1-dwc3";
				reg = <0x00 0x20f00000 0x00 0x100000>;
				status = "okay";
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				ranges;
				clocks = <0x23 0x00 0x23 0x01 0x23 0x02 0x24 0x05 0x07 0x06 0x25>;
				clock-names = "core_clk", "ref_clk", "susp_clk", "ipa_usb_ref", "ipa_usb_ref_source", "ipa_usb_ref_default";
				usb-phy = <0x26 0x26>;
				power-domains = <0x17>;
				extcon = <0x27 0x1c>;
				vbus-supply = <0x28>;
				phandle = <0x152>;

				dwc3@20f00000 {
					compatible = "snps,sprd-dwc3";
					usb-role-switch;
					reg = <0x00 0x20f00000 0x00 0x100000>;
					interrupts = <0x00 0x87 0x04>;
					interrupt-names = "irq";
					usb-phy = <0x26 0x26>;
					usb-pam = <0x29>;
					phy_type = "utmi_wide";
					snps,usb3-u1u2-disable;
					snps,dis_u3_susphy_quirk;
					snps,dis_u2_susphy_quirk;
					snps,overlap_check_quirk;
					snps,ep_out_aligned_size_quirk;
					snps,disconnect_event_quirk;
					snps,usb3_slow_suspend;
					snps,host_suspend_capable;
					snps,dis-del-phy-power-chg-quirk;
				};
			};

			pamu3: pamu3@21100000 {
				compatible = "sprd,roc1-pamu3";
				clocks = <0x23 0x04>;
				clock-names = "pamu3_clk";
				reg = <0x00 0x21100000 0x00 0x10000 0x00 0x20f00000 0x00 0x100000>;
				reg-names = "pamu3_glb_regs", "dwc3_core_regs";
				syscons = <0x16 0x00 0x02>;
				syscon-names = "reset";
				phandle = <0x29>;
			};

			ssphy: ssphy@323bc000 {
				compatible = "sprd,roc1-ssphy";
				#phy-cells = <0x00>;
				reg = <0x00 0x323bc000 0x00 0x4000>;
				reg-names = "phy_glb_regs";
				sprd,syscon-aon_apb = <0x10>;
				sprd,syscon-ipa-ahb = <0x16>;
				sprd,syscon-anag3 = <0x19>;
				sprd,syscon-pmu-apb = <0x02>;
				sprd,syscon-anatop = <0x1a>;
				sprd,syscon-anatop1 = <0x0d>;
				sprd,vdd-voltage = <0x325aa0>;
				io-channels = <0x2a 0x1e 0x2a 0x1f>;
				io-channel-names = "dp", "dm";
				status = "okay";
				vdd-supply = <0x1b>;
				extcon = <0x27>;
				phandle = <0x26>;
			};

			iommu_ai: iommu@6fe00000 {
				compatible = "unisoc,iommuexroc1-ai";
				reg = <0x00 0x6fe00000 0x00 0x800 0x00 0x6fd08004 0x00 0x80>;
				iova-base = <0x30000000>;
				iova-size = <0x80000000>;
				reg_name = "mmu_interrupt_reg", "mmu_reg";
				status = "okay";
				#iommu-cells = <0x00>;
				phandle = <0xb5>;
			};

			dsi: dsi@20400000 {
				compatible = "sprd,roc1-dsi-host";
				reg = <0x00 0x20400000 0x00 0x1000>;
				interrupts = <0x00 0x1e 0x04 0x00 0x1f 0x04>;
				status = "okay";
				syscons = <0x1d 0x04 0x01>;
				syscon-names = "reset";
				sprd,ip = "sprd,dsi-ctrl", "r3p0";
				sprd,soc = "roc1";
				sprd,mipi-drive-capability = <0x06>;
				clock-names = "clk_ap_ahb_dsi_eb";
				clocks = <0x18 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x153>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						dsi_out: endpoint {
							remote-endpoint = <0x2b>;
							phandle = <0x32>;
						};
					};

					port@1 {
						reg = <0x01>;

						dsi_in: endpoint@1 {
							remote-endpoint = <0x2c>;
							phandle = <0x22>;
						};
					};
				};

				panel: panel {
					compatible = "sprd,generic-mipi-panel";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;
					reset-gpio = <0x2d 0x32 0x00>;
					en3v3-gpio = <0x2d 0x3f 0x00>;
					power-supply = <0x2e>;
					power1v8-supply = <0x2f>;
					phandle = <0x154>;

					port {
						reg = <0x01>;

						panel_in: endpoint {
							remote-endpoint = <0x30>;
							phandle = <0x31>;
						};
					};
				};
			};

			dphy: dphy {
				compatible = "sprd,roc1-dsi-phy";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x00 0x20400000 0x00 0x1000>;
				status = "okay";
				syscons = <0x1d 0x40 0x03 0x02 0x35c 0x08>;
				syscon-names = "enable", "power";
				sprd,ip = "sprd,megacores-sharkl5";
				sprd,soc = "roc1";
				phandle = <0x155>;

				port@0 {
					reg = <0x00>;

					dphy_out: endpoint {
						remote-endpoint = <0x31>;
						phandle = <0x30>;
					};
				};

				port@1 {
					reg = <0x01>;

					dphy_in: endpoint {
						remote-endpoint = <0x32>;
						phandle = <0x2b>;
					};
				};
			};

			vsp: video-codec@20500000 {
				compatible = "sprd,roc1-vsp";
				reg = <0x00 0x20500000 0x00 0xc000>;
				interrupts = <0x00 0x22 0x04>;
				syscons = <0x1d 0x04 0x2800 0x02 0x18 0x2000000 0x02 0x18 0x1000000 0x02 0x584 0xff0000 0x10 0x04 0x20>;
				syscon-names = "reset", "pmu_vsp_force_shutdown", "pmu_vsp_auto_shutdown", "pmu_pwr_status", "vsp_domain_eb";
				iommus = <0x33>;
				sprd,qos = <0x34>;
				status = "okay";
				clock-names = "clk_ahb_gate_vsp_eb", "clk_src_256m", "clk_src_307m2", "clk_src_384m", "clk_src_512m", "clk_vsp";
				clocks = <0x18 0x02 0x07 0x09 0x07 0x0c 0x07 0x02 0x07 0x08 0x21 0x17>;
				phandle = <0x156>;
			};

			iommu_vsp: iommu@20500000 {
				compatible = "unisoc,iommuexroc1-vsp";
				reg = <0x00 0x20501000 0x00 0xb000 0x00 0x20500000 0x00 0x80>;
				iova-base = <0x40000000>;
				iova-size = <0x10000000>;
				reg_name = "mmu_interrupt_reg", "mmu_reg";
				status = "okay";
				#iommu-cells = <0x00>;
				phandle = <0x33>;
			};

			pcie1: pcie@20d00000 {
				compatible = "sprd,pcie", "snps,dw-pcie";
				reg = <0x00 0x20d00000 0x00 0x100000 0x03 0xf7f00000 0x00 0x100000>;
				reg-names = "dbi", "config";
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				device_type = "pci";
				ranges = <0x1000000 0x00 0x00 0x03 0xf7ef0000 0x00 0x10000 0x3000000 0x00 0x10000000 0x02 0x80000000 0x00 0x80000000>;
				bus-range = <0x10 0x1f>;
				num-lanes = <0x01>;
				num-vectors = <0x100>;
				num-viewport = <0x08>;
				pcie-wakeup-gpios = <0x35 0x0b 0x00>;
				status = "okay";
				power-domains = <0x17>;
				no-suspend;
				sprd,pcie-shutdown-syscons = <0x02 0x00 0x00 0x3cc 0x08 0x08 0x16 0x00 0x00 0x04 0x80 0x00 0x02 0x00 0x00 0xbc 0x2000 0x00 0x02 0x00 0x00 0xbc 0x100 0x00>;
				sprd,pcie-startup-syscons = <0x02 0x02 0x00 0x580 0xff000000 0x00 0x36 0x01 0x00 0x10 0x3000 0x1000 0x36 0x01 0x00 0x00 0x3e00 0x3e00 0x36 0x00 0x00 0x00 0x01 0x01 0x02 0x00 0x96 0xbc 0x100 0x100 0x16 0x00 0x96 0x04 0x80 0x80 0x02 0x00 0x7d0 0x3cc 0x08 0x00>;
				sprd,pcie-resume-syscons = <0x02 0x02 0x00 0x580 0xff000000 0x00 0x02 0x00 0x96 0xbc 0x100 0x100 0x16 0x00 0x96 0x04 0x80 0x80 0x02 0x00 0x7d0 0x3cc 0x08 0x00>;
				sprd,pcie-suspend-syscons = <0x02 0x00 0x00 0x3cc 0x08 0x08 0x16 0x00 0x00 0x04 0x80 0x00 0x02 0x00 0x00 0xbc 0x2000 0x00 0x02 0x00 0x00 0xbc 0x100 0x00>;
				phandle = <0x117>;

				dummy@0 {
					label = "msi_int";
					interrupt-parent = <0x01>;
					#interrupt-cells = <0x03>;
					interrupts = <0x00 0x99 0x04>;
				};

				dummy@1 {
					label = "aer_int";
					interrupt-parent = <0x01>;
					#interrupt-cells = <0x03>;
					interrupts = <0x00 0x9a 0x04>;
				};

				dummy@2 {
					label = "ipa_int";
					interrupt-parent = <0x37>;
					#interrupt-cells = <0x01>;
					interrupts = <0x14>;
				};
			};

			pcie0: pcie@20c00000 {
				compatible = "sprd,pcie", "snps,dw-pcie";
				reg = <0x00 0x20c00000 0x00 0x100000 0x03 0xffffe000 0x00 0x2000>;
				reg-names = "dbi", "config";
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				device_type = "pci";
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &ipa_intc 11>,
						<0 0 0 2 &ipa_intc 11>,
						<0 0 0 3 &ipa_intc 11>,
						<0 0 0 4 &ipa_intc 11>;
				ranges = <0x1000000 0x00 0x00 0x03 0xfffee000 0x00 0x10000 0x3000000 0x00 0x10000000 0x03 0xf8000000 0x00 0x7fee000>;
				bus-range = <0x00 0x0f>;
				num-lanes = <0x01>;
				num-vectors = <0x100>;
				num-viewport = <0x08>;
				pcie-wakeup-gpios = <0x35 0x0a 0x00>;
				status = "okay";
				power-domains = <0x17>;
				ep-poweron-late;
				sprd,pcie-startup-syscons = <0x38 0x01 0x00 0x08 0x100000 0x100000 0x02 0x00 0x00 0x800 0x10000 0x00 0x39 0x00 0x00 0x00 0x01 0x00 0x39 0x01 0x00 0x00 0x3e00 0x3e00 0x02 0x00 0x00 0xb8 0x100 0x100 0x02 0x00 0x00 0x4bc 0x04 0x04 0x02 0x02 0x00 0xd4 0xf000000 0x6000000 0x02 0x02 0x00 0x580 0xff000000 0x00 0x16 0x00 0x00 0x04 0x100 0x100 0x39 0x00 0x96 0x00 0x01 0x01 0x02 0x00 0x7d0 0x3cc 0x02 0x00>;
				sprd,pcie-shutdown-syscons = <0x02 0x00 0x00 0x3cc 0x02 0x02 0x39 0x00 0x00 0x00 0x01 0x00 0x16 0x00 0x00 0x04 0x100 0x00 0x02 0x00 0x00 0x4bc 0x04 0x00 0x02 0x00 0x00 0x35c 0x04 0x04 0x02 0x00 0x00 0xb8 0x2000 0x00 0x02 0x00 0x00 0xb8 0x100 0x00>;
				sprd,pcie-resume-syscons = <0x02 0x00 0xc8 0xb8 0x100 0x100 0x02 0x00 0x00 0x4bc 0x04 0x04 0x02 0x02 0x00 0xd4 0xf000000 0x6000000 0x02 0x02 0x00 0x580 0xff000000 0x00 0x16 0x00 0xc8 0x04 0x100 0x100 0x39 0x01 0x00 0x00 0x3e00 0x3e00 0x39 0x00 0x96 0x00 0x01 0x01 0x02 0x00 0x7d0 0x3cc 0x02 0x00>;
				sprd,pcie-suspend-syscons = <0x02 0x00 0x00 0x3cc 0x02 0x02 0x39 0x00 0x00 0x00 0x01 0x00 0x16 0x00 0x00 0x04 0x100 0x00 0x02 0x00 0x00 0x4bc 0x04 0x00 0x02 0x00 0x00 0x35c 0x04 0x04 0x02 0x00 0x00 0xb8 0x2000 0x00 0x02 0x00 0x00 0xb8 0x100 0x00>;
				sprd,pcie-aspml1p2-syscons = <0x3a 0x01 0x00 0xb4 0x800000 0x800000 0x3a 0x01 0x00 0xb4 0x10000000 0x10000000 0x02 0x01 0x00 0x3d8 0xff0000 0x4e0000 0x02 0x01 0x00 0x3d8 0xff 0x4e 0x02 0x01 0x00 0x68 0xff 0x05 0x02 0x01 0x00 0x800 0x10000 0x10000 0x02 0x01 0x00 0x800 0x01 0x00>;
				sprd,pcie-autogateclk-syscons = <0x02 0x01 0x00 0x800 0x10000 0x00 0x02 0x01 0x00 0x800 0x01 0x01>;
				sprd,pcie-notgateclk-syscons = <0x02 0x01 0x00 0x800 0x10000 0x10000 0x02 0x01 0x00 0x800 0x01 0x00>;
				phandle = <0x128>;

				dummy@0 {
					label = "msi_int";
					interrupt-parent = <0x01>;
					#interrupt-cells = <0x03>;
					interrupts = <0x00 0x94 0x04>;
				};

				dummy@1 {
					label = "aer_int";
					interrupt-parent = <0x01>;
					#interrupt-cells = <0x03>;
					interrupts = <0x00 0x95 0x04>;
				};

				dummy@2 {
					label = "ipa_int";
					interrupt-parent = <0x37>;
					#interrupt-cells = <0x01>;
					interrupts = <0x0b>;
				};
			};
		};

		aon {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			eic_debounce: gpio@32000000 {
				compatible = "sprd,roc1-eic-debounce";
				reg = <0x00 0x32000000 0x00 0x80 0x00 0x32010000 0x00 0x80 0x00 0x32020000 0x00 0x80 0x00 0x32030000 0x00 0x80 0x00 0x32230000 0x00 0x80 0x00 0x32270000 0x00 0x80>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x157>;
			};

			eic_latch: gpio@32000080 {
				compatible = "sprd,roc1-eic-latch";
				reg = <0x00 0x32000080 0x00 0x20 0x00 0x32010080 0x00 0x20 0x00 0x32020080 0x00 0x20 0x00 0x32030080 0x00 0x20 0x00 0x32230080 0x00 0x20 0x00 0x32270080 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x158>;
			};

			eic_async: gpio@320000a0 {
				compatible = "sprd,roc1-eic-async";
				reg = <0x00 0x320000a0 0x00 0x20 0x00 0x320100a0 0x00 0x20 0x00 0x320200a0 0x00 0x20 0x00 0x320300a0 0x00 0x20 0x00 0x322300a0 0x00 0x20 0x00 0x322700a0 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x35>;
			};

			eic_sync: gpio@320000c0 {
				compatible = "sprd,roc1-eic-sync";
				reg = <0x00 0x320000c0 0x00 0x20 0x00 0x320100c0 0x00 0x20 0x00 0x320200c0 0x00 0x20 0x00 0x320300c0 0x00 0x20 0x00 0x322300c0 0x00 0x20 0x00 0x322700c0 0x00 0x20>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x48 0x04>;
				phandle = <0x159>;
			};

			timer@32050000 {
				compatible = "sprd,roc1-timer";
				reg = <0x00 0x32050000 0x00 0x20>;
				interrupts = <0x00 0x47 0x04>;
				clocks = <0x25>;
			};

			timer@32050020 {
				compatible = "sprd,roc1-suspend-timer";
				reg = <0x00 0x32050020 0x00 0x20>;
				clocks = <0x25>;
			};

			aon_i2c0: i2c@32060000 {
				compatible = "sprd,roc1-hw-i2c";
				reg = <0x00 0x32060000 0x00 0x1000>;
				interrupts = <0x00 0x44 0x04>;
				clock-names = "source", "enable", "i2c";
				clocks = <&ext_26m>, <&aonapb_gate 0x2c>,
					 <&aon_clk 0x11>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				phandle = <0x15a>;

				cpudvfs-dcdc-cpu1@62 {
					compatible = "sprd,cpudvfs-regulator-dcdc-cpu1-roc1";
					reg = <0x62>;
					dvfs-dcdc-i2c = <0x01>;
				};
			};

			ap_gpio: gpio@32070000 {
				compatible = "sprd,roc1-gpio";
				reg = <0x00 0x32070000 0x00 0x10000>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x3d 0x04>;
				phandle = <0x2d>;
			};

			ap_thm0: thermal@32200000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32200000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x28>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x3b 0x3c>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10c>;

				core6a7-big@0 {
					reg = <0x00>;
					nvmem-cells = <0x3d>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core4-big@1 {
					reg = <0x01>;
					nvmem-cells = <0x3e>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core5-big@2 {
					reg = <0x02>;
					nvmem-cells = <0x3f>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core6-big@3 {
					reg = <0x03>;
					nvmem-cells = <0x40>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core7-big@4 {
					reg = <0x04>;
					nvmem-cells = <0x41>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm1: thermal@32210000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32210000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x29>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x42 0x43>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10d>;

				ai0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x44>;
					nvmem-cell-names = "sen_delta_cal";
				};

				ai1-sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x45>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm2: thermal@32220000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32220000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x2a>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x46 0x47>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10e>;

				gpu0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x48>;
					nvmem-cell-names = "sen_delta_cal";
				};

				mm-sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x49>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			ap_thm3: thermal@32520000 {
				compatible = "sprd,roc1-thermal";
				reg = <0x00 0x32520000 0x00 0x10000>;
				clock-names = "enable";
				clocks = <0x04 0x23>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x4a 0x4b>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x10f>;

				cputop0-sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x4c>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core0-little@1 {
					reg = <0x01>;
					nvmem-cells = <0x4d>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core1-little@2 {
					reg = <0x02>;
					nvmem-cells = <0x4e>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core2-little@3 {
					reg = <0x03>;
					nvmem-cells = <0x4f>;
					nvmem-cell-names = "sen_delta_cal";
				};

				core3-little@4 {
					reg = <0x04>;
					nvmem-cells = <0x50>;
					nvmem-cell-names = "sen_delta_cal";
				};

				cputop1-sensor@5 {
					reg = <0x05>;
					nvmem-cells = <0x51>;
					nvmem-cell-names = "sen_delta_cal";
				};

				gpu1-sensor@6 {
					reg = <0x06>;
					nvmem-cells = <0x52>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			cluster0_sensor: cluster0-sensor@15 {
				compatible = "sprd,cluster0-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "littlecore0-thmzone", "littlecore1-thmzone", "littlecore2-thmzone", "littlecore3-thmzone";
				k-po = <0x80>;
				k-pu = <0x100>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x2710>;
				phandle = <0x110>;
			};

			cluster1_sensor: cluster1-sensor@16 {
				compatible = "sprd,cluster1-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "bigcore4-thmzone", "bigcore5-thmzone", "bigcore6-thmzone", "bigcore7-thmzone";
				k-po = <0x80>;
				k-pu = <0x100>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x2710>;
				phandle = <0x111>;
			};

			soc_sensor: soc-sensor@17 {
				compatible = "sprd,soc-thermal";
				#thermal-sensor-cells = <0x01>;
				sensor-names = "cluster0-thmzone", "cluster1-thmzone";
				k-po = <0x00>;
				k-pu = <0x00>;
				k-i = <0x02>;
				k-d = <0x00>;
				cutoff = <0x00>;
				phandle = <0x108>;
			};

			ap_efuse: efuse@32240000 {
				compatible = "sprd,roc1-efuse";
				reg = <0x00 0x32240000 0x00 0x10000>;
				clock-names = "enable";
				hwlocks = <0x53 0x08>;
				clocks = <0x04 0x13>;
				phandle = <0x15b>;

				thm0_sign: thm0-sign@8c {
					reg = <0x8c 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x3b>;
				};

				thm0_ratio: thm0-ratio@8c {
					reg = <0x8c 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x3c>;
				};

				thm0_sen0: thm0-sen0@8c {
					reg = <0x8d 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3d>;
				};

				thm0_sen1: thm0-sen1@94 {
					reg = <0x95 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3e>;
				};

				thm0_sen2: thm0-sen2@94 {
					reg = <0x94 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x3f>;
				};

				thm0_sen3: thm0-sen3@97 {
					reg = <0x97 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x40>;
				};

				thm0_sen4: thm0-sen4@96 {
					reg = <0x96 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x41>;
				};

				thm1_sign: thm1-sign@90 {
					reg = <0x90 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x42>;
				};

				thm1_ratio: thm1-ratio@90 {
					reg = <0x90 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x43>;
				};

				thm1_sen0: thm1-sen0@91 {
					reg = <0x91 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x44>;
				};

				thm1_sen1: thm1-sen1@99 {
					reg = <0x99 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x45>;
				};

				thm2_sign: thm2-sign@92 {
					reg = <0x92 0x04>;
					bits = <0x00 0x01>;
					phandle = <0x46>;
				};

				thm2_ratio: thm2-ratio@92 {
					reg = <0x92 0x04>;
					bits = <0x01 0x07>;
					phandle = <0x47>;
				};

				thm2_sen0: thm2-sen0@93 {
					reg = <0x93 0x04>;
					bits = <0x00 0x08>;
					phandle = <0x48>;

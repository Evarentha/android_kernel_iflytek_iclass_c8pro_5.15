	firmware {

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				fs_vendor: vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1";
					fsmgr_flags = "wait";
					phandle = <0x1c0>;
				};

				fs_product: product {
					compatible = "android,product";
					dev = "/dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/product";
					type = "ext4";
					mnt_flags = "ro,barrier=1";
					fsmgr_flags = "wait";
					phandle = <0x1c1>;
				};
			};
		};
	};

	display-subsystem {
		compatible = "sprd,display-subsystem";
		ports = <0x106>;
		gsp = <0x107>;
	};

	dpu_dvfs: dpu-dvfs {
		compatible = "sprd,hwdvfs-dpu-roc1";
		sprd,hw-dfs-en = <0x01>;
		sprd,work-index-def = <0x04>;
		sprd,idle-index-def = <0x02>;
		sprd,freq-upd-delay-en = <0x00>;
		sprd,freq-upd-hdsk-en = <0x01>;
		operating-points = <0x25800 0xaae60 0x2ee00 0xaae60 0x3e800 0xaae60 0x4b000 0xaae60 0x5dc00 0xb71b0>;
		phandle = <0x1c2>;
	};

	vdsp_dvfs: vdsp-dvfs {
		compatible = "sprd,hwdvfs-vdsp-roc1";
		sprd,hw-dvfs-en = <0x00>;
		sprd,work-index-def = <0x05>;
		sprd,idle-index-def = <0x01>;
		sprd,freq-upd-delay-en = <0x00>;
		sprd,freq-upd-hdsk-en = <0x01>;
		operating-points = <0x2ee00 0xaae60 0x4b000 0xaae60 0x72420 0xb71b0 0x96000 0xc3500 0xab630 0xc3500 0xbb800 0xc3500>;
		phandle = <0x1c3>;
	};

	vsp_dvfs: vsp-dvfs {
		compatible = "sprd,hwdvfs-vsp-roc1";
		sprd,dvfs-work-freq = <0x16e36000>;
		sprd,dvfs-idle-freq = <0xf424000>;
		sprd,dvfs-enable-flag = <0x01>;
		sprd,freq-upd-delay-en = <0x00>;
		sprd,freq-upd-hdsk-en = <0x01>;
		operating-points = <0x3e800 0xaae60 0x4b000 0xaae60 0x5dc00 0xb71b0 0x7d000 0xc3500>;
		phandle = <0x1c4>;
	};

	sprd-sensorhub {
		compatible = "sprd,roc1-sensorhub";
		sprd,iio-name = "SPRDSensor";
	};

	thm_zone: thermal-zones {
		phandle = <0x1c5>;

		soc_thmzone: soc-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x12c0>;
			thermal-sensors = <0x108 0x11>;
			phandle = <0x1c6>;

			trips {

				soc_threshold: trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x1c7>;
				};

				soc_target: trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x109>;
				};

				soc_crit: soc_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x1c8>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x109>;
					contribution = <0x400>;
					cooling-device = <0x10a 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x109>;
					contribution = <0x2a2>;
					cooling-device = <0x10b 0xffffffff 0xffffffff>;
				};
			};
		};


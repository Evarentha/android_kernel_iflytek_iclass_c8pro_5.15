			sprd,sleep-in-command = [05 0a 00 01 28 05 65 00 01 10];
			phandle = <0x1f7>;

			display-timings {

				timing0 {
					clock-frequency = <0x927c000>;
					hactive = <0x4b0>;
					vactive = <0x780>;
					hback-porch = <0xa0>;
					hfront-porch = <0x78>;

			phandle = <0x1f6>;

			display-timings {

				timing0 {
					clock-frequency = <0x927c000>;
					hactive = <0x4b0>;
					vactive = <0x780>;
					hback-porch = <0x20>;
					hfront-porch = <0x2a>;
					vback-porch = <0x19>;
					vfront-porch = <0x23>;
					hsync-len = <0x01>;
					vsync-len = <0x01>;
				};
			};
		};

		lcd_cblite_hx8279_mipi_hd: lcd_cblite_hx8279_mipi_hd {
			sprd,dsi-work-mode = <0x01>;

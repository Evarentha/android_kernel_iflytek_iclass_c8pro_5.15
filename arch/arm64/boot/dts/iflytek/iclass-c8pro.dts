		charge-unknown-current-microamp = <0xf4240 0xf4240>;
		charge-fchg-current-microamp = <0x1e8480 0xf4240>;
		phandle = <0x85>;
	};

	charger-manager {
		compatible = "charger-manager";
		phys = <&ssphy>;
		cm-name = "battery";
		cm-poll-mode = <0x02>;
		cm-poll-interval = <0x3a98>;
		cm-battery-stat = <0x02>;
		cm-fullbatt-vchkdrop-ms = <0x00>;
		cm-fullbatt-vchkdrop-volt = <0x00>;
		cm-fullbatt-voltage = <0x4127b0>;
		cm-fullbatt-current = <0x2bf20>;
		cm-fullbatt-capacity = <0x64>;
		cm-num-chargers = <0x01>;
		cm-chargers = "sc2703_charger";
		cm-fuel-gauge = "sc27xx-fgu";
		cm-battery-cold = <0xc8>;
		cm-battery-cold-in-minus;
		cm-battery-hot = <0x320>;
		cm-battery-temp-diff = <0x64>;
		cm-charging-max = <0x3dcc500>;
		cm-discharging-max = <0xa4cb80>;
		cm-wdt-interval = <0x3c>;
		cm-shutdown-voltage = <0x2f4d60>;
		cm-tickle-time-out = <0x5dc>;
		cm-one-cap-time = <0x1e>;
		cm-charge-voltage-max = <0x632ea0>;
		cm-charge-voltage-drop = <0xaae60>;
		cm-fast-charge-voltage-max = <0xa037a0>;
		cm-fast-charge-voltage-drop = <0xaae60>;
		cm-fast-charge-all-current = <0x1e8480>;
		cm-dcp-jeita-temp-table = <0x3e8 0x406 0x00 0x419ce0 0x47e 0x49c 0x16e360 0x419ce0 0x5aa 0x58c 0x1e8480 0x419ce0 0x640 0x622 0x1e8480 0x3e8fa0>;
		cm-sdp-jeita-temp-table = <0x3e8 0x406 0x00 0x419ce0 0x47e 0x49c 0x7a120 0x419ce0 0x5aa 0x58c 0x7a120 0x419ce0 0x640 0x622 0x7a120 0x3e8fa0>;
		cm-cdp-jeita-temp-table = <0x3e8 0x406 0x00 0x419ce0 0x47e 0x49c 0x7a120 0x419ce0 0x5aa 0x58c 0x16e360 0x419ce0 0x640 0x622 0x7a120 0x3e8fa0>;
		cm-unknown-jeita-temp-table = <0x3e8 0x406 0x00 0x419ce0 0x47e 0x49c 0xf4240 0x419ce0 0x5aa 0x58c 0xf4240 0x419ce0 0x640 0x622 0x7a120 0x3e8fa0>;
		cm-fchg-jeita-temp-table = <0x3e8 0x406 0x00 0x419ce0 0x47e 0x49c 0xb71b0 0x419ce0 0x5aa 0x58c 0x1e8480 0x419ce0 0x640 0x622 0x118c30 0x3e8fa0>;
		monitored-battery = <0x85 0x85>;
		cm-capacity-track;

		regulator@0 {
			cm-regulator-name = "vddgen0";

			cable@0 {
				cm-cable-name = "USB";
				extcon = <0x1c>;
			};
		};
	};

	sprd-mtty {
		compatible = "sprd,mtty";
		sprd,name = "ttyBT";
	};

	sprd-fm {
		compatible = "sprd,marlin3-fm";
		sprd,name = "sprd-fm";
	};

	dvfs_dcdc_cpu0_supply: dvfs-dcdc-cpu0-supply {
		pmic-type-num = <0x01>;
		supply-type-sel = <0x29c 0x00 0x01>;
		top-dvfs-i2c-state = <0x88 0x04 0x0f>;
		voltage-grade-num = <0x07>;
		voltage-grade = <0x00 0x2d 0x260 0x00 0xffff 0x01 0x32 0x260 0x10 0xffff 0x02 0x37 0x264 0x00 0xffff 0x03 0x3c 0x264 0x10 0xffff 0x04 0x41 0x268 0x00 0xffff 0x05 0x46 0x268 0x10 0xffff 0x06 0x4b 0x26c 0x00 0xffff>;
		tuning-latency-us = <0xc8>;
		chnl-in-i2c = <0x01>;
		slew-rate = <0x4e20>;
		phandle = <0x58>;
	};

	dvfs_dcdc_cpu1_supply: dvfs-dcdc-cpu1-supply {
		supply-type-sel = <0x2a0 0x00 0x01>;
		/* AON I2C0 channels target DA9121 registers 0x20 and 0x25. */
		pmic-type-num = <0x03>;
		top-dvfs-i2c-state = <0x8c 0x04 0x0f>;
		voltage-grade-num = <0x07>;
		voltage-grade = <0x00 0x4b 0x280 0x00 0xffff 0x01 0x50 0x280 0x10 0xffff 0x02 0x55 0x284 0x00 0xffff 0x03 0x5a 0x284 0x10 0xffff 0x04 0x5f 0x288 0x00 0xffff 0x05 0x64 0x288 0x10 0xffff 0x06 0x69 0x28c 0x00 0xffff>;
		voltage-up-delay = <0x32 0x130 0x00 0xffff 0x1600 0x64 0x130 0x10 0xffff 0x1a00 0x96 0x134 0x00 0xffff 0x1f00 0xc8 0x134 0x10 0xffff 0x2400 0xfa 0x138 0x00 0xffff 0x2900 0x12c 0x138 0x10 0xffff 0x2e00 0x15e 0x13c 0x00 0xffff 0x3300>;
		voltage-down-delay = <0x32 0x140 0x00 0xffff 0x1600 0x64 0x140 0x10 0xffff 0x1a00 0x96 0x144 0x00 0xffff 0x1f00 0xc8 0x144 0x10 0xffff 0x2400 0xfa 0x148 0x00 0xffff 0x2900 0x12c 0x148 0x10 0xffff 0x2e00 0x15e 0x14c 0x00 0xffff 0x3300>;
		tuning-latency-us = <0xc8>;
		chnl-in-i2c = <0x01>;
		phandle = <0x59>;
	};

	tboard_thermistor: thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x2a 0x01>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <0xffff64c2 0x489 0xffff8baf 0x475 0xffffb3e8 0x451 0xffffedb9 0x3f4 0x277e 0x35f 0x60e5 0x2a0 0xaf7a 0x1a7 0xd677 0x143 0xfd7f 0xf3 0x12484 0xb6 0x14b93 0x88 0x172a3 0x66 0x199b0 0x4d 0x1c0c9 0x3a 0x1e7c8 0x2d>;
		phandle = <0x112>;
	};

	extcon_gpio: extcon-gpio {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpio = <0x83 0x00 0x00>;
		phandle = <0x27>;
	};

	ddr_dfs: scene-frequency {
		compatible = "sprd,dfs";
		freq-num = <0x08>;
		backdoor = <0x74a>;
		phandle = <0x1f8>;
	};

};

				clock-names = "cpp_eb", "cpp_clk", "cpp_clk_parent";
				clocks = <0x05 0x00 0x06 0x05 0x07 0x02>;
				sprd,cam-ahb-syscon = <0x03>;
				iommus = <0x13>;
				status = "okay";
				phandle = <0x14b>;
			};

			iommu_cpp: iommu@62800000 {
				compatible = "unisoc,iommuexroc1-cpp";
				reg = <0x00 0x62800000 0x00 0x200 0x00 0x62800200 0x00 0x60>;
				iova-base = <0x20000000>;
				iova-size = <0x10000000>;
				reg_name = "mmu_interrupt_reg", "mmu_reg", "iova pool";

					scu-dvfs-tbl-1 = <0x00 0x00 0x00 0x00 0x00 0x04 0x00 0x00 0x01 0x00 0x04 0x00 0x00 0x01 0x01 0x01 0x00 0x00 0x01 0x00 0x04 0x00 0x01 0x01 0x02 0x04 0x00 0x02 0x01 0x03 0x04 0x00 0x03 0x01 0x03 0x04 0x00 0x04 0x01 0x04 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05 0x04 0x00 0x05 0x01 0x05>;
					scu-dvfs-tbl-2 = <0x00 0x00 0x00 0x00 0x00 0x04 0x00 0x00 0x01 0x00 0x04 0x00 0x00 0x01 0x01 0x01 0x00 0x01 0x01 0x00 0x04 0x00 0x02 0x01 0x02 0x04 0x00 0x03 0x01 0x03 0x04 0x00 0x04 0x01 0x03 0x04 0x00 0x05 0x01 0x04 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05>;
					scu-dvfs-tbl-3 = <0x00 0x00 0x00 0x00 0x00 0x04 0x00 0x00 0x01 0x00 0x04 0x00 0x00 0x01 0x01 0x01 0x00 0x01 0x01 0x00 0x04 0x00 0x02 0x01 0x02 0x04 0x00 0x03 0x01 0x03 0x04 0x00 0x04 0x01 0x03 0x04 0x00 0x05 0x01 0x04 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05 0x04 0x00 0x06 0x01 0x05>;
					scu-dvfs-tbl-4 = <0x00 0x00 0x00 0x00 0x00 0x04 0x00 0x00 0x01 0x00 0x04 0x00 0x01 0x01 0x01 0x01 0x00 0x02 0x01 0x00 0x04 0x00 0x03 0x01 0x02 0x04 0x00 0x04 0x01 0x03 0x04 0x00 0x05 0x01 0x03 0x04 0x00 0x06 0x01 0x04 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05 0x04 0x00 0x07 0x01 0x05>;
					phandle = <0x68>;

					scu_dev: scu-dev {
						device-name = "scu";
						sel-get = <0x3c 0x0a 0x07>;
						div-get = <0x3c 0x0d 0x07>;
						vol-get = <0x34 0x00 0x07>;
						dfs-idle-disable = <0x308 0x08 0x01>;
						phandle = <0x73>;
					};

					ace_dev: ace-dev {
						device-name = "ace";
						sel-get = <0x3c 0x0a 0x07>;
						div-get = <0x3c 0x10 0x07>;
						vol-get = <0x34 0x00 0x07>;
						phandle = <0x74>;
					};
				};

				periph_cluster: periph-cluster {
					cluster-name = "periph-cluster";
					row-num = <0x08>;
					column-num = <0x03>;
					work-index-cfg = <0x23c 0x07>;
					idle-index-cfg = <0x240 0x07>;
					dcdc-name = "DCDC_CPU0";
					tuning-func-cfg = <0x18 0x00>;
					map-tbl-regs = <0x1f4 0x1f8 0x1fc 0x200 0x204 0x208 0x20c 0x210>;
					column-entry-start-bit = <0x00 0x02 0x05>;
					column-entry-mask = <0x03 0x07 0x07>;
					cluster-devices = <0x75>;
					periph-dvfs-tbl = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02>;
					periph-dvfs-tbl-1 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x00 0x02 0x01 0x00 0x02 0x01 0x00 0x02 0x01 0x00 0x02 0x01 0x00 0x02 0x01 0x00>;
					periph-dvfs-tbl-2 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01>;
					periph-dvfs-tbl-3 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01 0x02 0x01 0x01>;
					periph-dvfs-tbl-4 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02 0x02 0x01 0x02>;
					phandle = <0x69>;

					periph_dev: periph-dev {
						device-name = "periph";
						sel-get = <0x3c 0x13 0x03>;
						div-get = <0x3c 0x15 0x07>;
						vol-get = <0x34 0x06 0x07>;
						dfs-idle-disable = <0x308 0x0a 0x01>;
						phandle = <0x75>;
					};
				};

				gic_cluster: gic-cluster {
					cluster-name = "gic-cluster";
					row-num = <0x08>;
					column-num = <0x03>;
					work-index-cfg = <0x2e0 0x07>;
					idle-index-cfg = <0x2e4 0x07>;
					dcdc-name = "DCDC_CPU0";
					tuning-func-cfg = <0x18 0x02>;
					map-tbl-regs = <0x280 0x284 0x288 0x28c 0x290 0x294 0x298 0x29c>;
					column-entry-start-bit = <0x00 0x02 0x05>;
					column-entry-mask = <0x03 0x07 0x07>;
					cluster-devices = <0x76>;
					gic-dvfs-tbl = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x02 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04>;
					gic-dvfs-tbl-1 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x00 0x03 0x01 0x02 0x03 0x01 0x02 0x03 0x01 0x02 0x03 0x01 0x02 0x03 0x01 0x02>;
					gic-dvfs-tbl-2 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x01 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03>;
					gic-dvfs-tbl-3 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x01 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03 0x03 0x01 0x03>;
					gic-dvfs-tbl-4 = <0x00 0x00 0x00 0x01 0x00 0x00 0x02 0x01 0x02 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04 0x03 0x01 0x04>;
					phandle = <0x6a>;

					gic_dev: gic-dev {
						device-name = "gic";
						sel-get = <0x40 0x00 0x03>;
						div-get = <0x40 0x02 0x07>;
						vol-get = <0x34 0x09 0x07>;
						dfs-idle-disable = <0x308 0x0b 0x01>;
						phandle = <0x76>;
					};
				};

				mpll_0: mpll-ananke {
					sprd,syscon-ang = <0x77>;
					mpll-rst = <0x44 0x00 0x01 0x02>;
					relock-cfg = <0x244 0x01>;
					pd-cfg = <0x244 0x00>;
					phandle = <0x61>;
				};

				mpll_1: mpll-prometheus {
					sprd,syscon-ang = <0x78>;
					mpll-rst = <0x40 0x02 0x04 0x03>;
					relock-cfg = <0x258 0x01>;
					pd-cfg = <0x258 0x00>;
					phandle = <0x62>;
				};

				mpll_2: mpll-scu {
					sprd,syscon-ang = <0x79>;
					mpll-rst = <0x40 0x00 0x01 0x02>;
					relock-cfg = <0x26c 0x01>;
					pd-cfg = <0x26c 0x00>;
					phandle = <0x63>;
				};

				apcpu_cpu0: apcpu-cpu0 {
					subsys-dcdc-vol-sw = <0x20 0x04 0x07 0x00>;
					subsys-dvfs-state = <0x44 0x00 0x07>;
					phandle = <0x64>;
				};

				apcpu_cpu1: apcpu-cpu1 {
					subsys-dcdc-vol-sw = <0x24 0x04 0x07 0x00>;
					subsys-dvfs-state = <0x4c 0x00 0x07>;
					phandle = <0x65>;
				};
			};

			pwms: pwm@32260000 {
				compatible = "sprd,sharkl5-pwm", "sprd,roc1-pwm";
				reg = <0x00 0x32260000 0x00 0x10000>;
				status = "okay";
				clock-names = "pwm0", "enable0", "pwm1", "enable1",
					      "pwm2", "enable2", "pwm3", "enable3";
				clocks = <&aon_clk CLK_AON_PWM0>, <&aonapb_gate CLK_PWM0_EB>,
					 <&aon_clk CLK_AON_PWM1>, <&aonapb_gate CLK_PWM1_EB>,
					 <&aon_clk CLK_AON_PWM2>, <&aonapb_gate CLK_PWM2_EB>,
					 <&aon_clk CLK_AON_PWM3>, <&aonapb_gate CLK_PWM3_EB>;
				assigned-clocks = <&aon_clk CLK_AON_PWM0>, <&aon_clk CLK_AON_PWM1>,
						  <&aon_clk CLK_AON_PWM2>, <&aon_clk CLK_AON_PWM3>;
				assigned-clock-parents = <&ext_26m>, <&ext_26m>,
							 <&ext_26m>, <&ext_26m>;
				counter-bits = "10bit", "10bit", "10bit", "10bit";
				#pwm-cells = <0x02>;
				phandle = <0x15d>;
			};

			usb: usb@0x5fff0000 {
				compatible = "sprd,roc1-musb";
				reg = <0x00 0x5fff0000 0x00 0x2000>;
				interrupts = <0x00 0x45 0x04>;
				interrupt-names = "mc";
				clocks = <0x04 0x1b>;
				clock-names = "core_clk";
				usb-phy = <0x7c>;
				phy-names = "usb";
				dr-mode = "peripheral";
				extcon = <0x1c>;
				vbus-supply = <0x28>;
				status = "disabled";
				phandle = <0x15e>;
			};

			aon_mailbox: mailbox@320a0000 {
				compatible = "unisoc,mailbox";
				reg = <0x00 0x320a0000 0x00 0x8000 0x00 0x320a8000 0x00 0x8000>;
				reg-names = "inbox", "outbox";
				sprd,mailbox_clk = <&aon_apb_regs 0x04 0x04>;
				interrupts = <0x00 0x52 0x04 0x00 0x53 0x04 0x00 0x54 0x04>;
				interrupt-names = "inbox", "outbox", "oob-outbox";
				#mbox-cells = <0x02>;
				phandle = <0x15f>;
			};

			adi_bus: spi@32100000 {
				/* 5.15 spi-sprd-adi binding: the sharkl5 (= ums512) family
				 * ADI IP is matched by "sprd,ums512-adi"; ums512_data in the
				 * driver carries the same SC2730 constants the 4.14
				 * sharkl5_data had.  The factory DTB's legacy
				 * "sprd,sharkl5-adi"/"sprd,roc1-adi" strings are not in
				 * the 5.15 driver's match table. */
				compatible = "sprd,ums512-adi";
				reg = <0x00 0x32100000 0x00 0x100000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				sprd,hw-channels = <0x02 0x18cc 0x03 0x18cc 0x0d 0x1854 0x0f 0x1874 0x11 0x1844 0x13 0x1844 0x1e 0x1820 0x23 0x19b8 0x27 0x19ac>;
				phandle = <0x160>;

				sc2730_pmic: pmic@0 {
					compatible = "sprd,sc2730";
					reg = <0x00>;
					spi-max-frequency = <0x18cba80>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0xad 0x04>;
					phandle = <0x7d>;

					bc1p2 {
						compatible = "sprd,sc2730-bc1p2";
					};

					led-controller@180 {
						compatible = "sprd,sc27xx-bltc", "sprd,sc2730-bltc";
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x180>;

						led@0 {
							label = "red";
							reg = <0x00>;
						};

						led@1 {
							label = "green";
							reg = <0x01>;
						};

						led@2 {
							label = "blue";
							reg = <0x02>;
						};
					};

					rtc@200 {
						compatible = "sprd,sc27xx-rtc", "sprd,sc2730-rtc";
						reg = <0x200>;
						interrupt-parent = <0x7d>;
						interrupts = <0x01 0x04>;
					};

					pmic_eic: gpio@280 {
						compatible = "sprd,sc27xx-eic", "sprd,sc2730-eic";
						reg = <0x280>;
						interrupt-parent = <0x7d>;
						interrupts = <0x04 0x04>;
						gpio-controller;
						#gpio-cells = <0x02>;
						interrupt-controller;
						#interrupt-cells = <0x02>;
						phandle = <0x83>;
					};

					efuse@300 {
						compatible = "sprd,sc27xx-efuse", "sprd,sc2730-efuse";
						reg = <0x300>;
						#address-cells = <0x01>;
						#size-cells = <0x01>;
						hwlocks = <0x53 0x0c>;

						adc_bcal: calib@0 {
							reg = <0x24 0x02>;
							phandle = <0x81>;
						};

						adc_scal: calib@1 {
							reg = <0x26 0x02>;
							phandle = <0x82>;
						};

						pddelta_calib: calib@2 {
							reg = <0x02 0x02>;
							phandle = <0x87>;
						};

						pdrc_calib: calib@6 {
							reg = <0x06 0x02>;
							phandle = <0x86>;
						};

						pdref_calib: calib@1e {
							reg = <0x1e 0x02>;
							phandle = <0x88>;
						};

						fgu_calib: calib@3 {
							reg = <0x06 0x02>;
							phandle = <0x84>;
						};

						cc_cal: calib@d {
							reg = <0x1a 0x02>;
							phandle = <0x7e>;
						};

						aud_pabst_vcal: calib@20 {
							reg = <0x20 0x02>;
							phandle = <0x89>;
						};

						neg_cp_efuse: calib@22 {
							reg = <0x22 0x02>;
							phandle = <0x8a>;
						};

						headset_adc_fir: calib@14 {
							reg = <0x28 0x02>;
							phandle = <0x80>;
						};

						headset_adc_sec: calib@16 {
							reg = <0x2c 0x02>;
							phandle = <0x118>;
						};
					};

					pmic_typec: typec@380 {
						compatible = "sprd,sc27xx-typec", "sprd,sc2730-typec";
						interrupt-parent = <0x7d>;
						interrupts = <0x08 0x04>;
						reg = <0x380>;
						sprd,mode = <0x02>;
						/* Both CC fields share this SC2730 efuse word. */
						nvmem-cells = <0x7e>, <0x7e>;
						nvmem-cell-names = "typec_cc1_cal", "typec_cc2_cal";
						vddldo-supply = <0x7f>;
						status = "okay";
						phandle = <0x1c>;

						vconn: typec-vconn {
							regulator-name = "vconn";
							phandle = <0x161>;
						};
					};

					pmic_fchg: fchg@400 {
						compatible = "sprd,sc27xx-fast-chg", "sprd,sc2730-fast-charger";
						reg = <0x400>;
						interrupt-parent = <0x7d>;
						interrupts = <0x05 0x04>;
						nvmem-cell-names = "fchg_cur_calib";
						nvmem-cells = <0x80>;
						status = "okay";
						sprd,input-voltage-microvolt = <0x4c4b40>;
						phys = <0x26>;
						phandle = <0x162>;
					};

					pmic_adc: adc@504 {
						compatible = "sprd,sc27xx-adc", "sprd,sc2730-adc";
						reg = <0x504>;
						interrupt-parent = <0x7d>;
						interrupts = <0x00 0x04>;
						#io-channel-cells = <0x01>;
						hwlocks = <0x53 0x04>;
						nvmem-cells = <0x81 0x82>;
						nvmem-cell-names = "big_scale_calib", "small_scale_calib";
						phandle = <0x2a>;
					};

					pmic_fgu: fgu@c00 {
						compatible = "sprd,sc27xx-fgu", "sprd,sc2730-fgu";
						reg = <0xc00>;
						bat-detect-gpio = <0x83 0x03 0x00>;
						nvmem-cell-names = "fgu_calib";
						nvmem-cells = <0x84>;
						io-channels = <0x2a 0x00 0x2a 0x0e>;
						io-channel-names = "bat-temp", "charge-vol";
						sprd,comp-resistance-mohm = <0x14>;
						interrupt-parent = <0x7d>;
						interrupts = <0x03 0x04>;
						monitored-battery = <0x85 0x85>;
						/* 5.15 uses a fixed 20000 uOhm ideal resistance. */
						sprd,calib-resistance-micro-ohms = <0x2710>;
						phandle = <0x163>;
					};

					pmic_pd: pd@e00 {
						compatible = "sprd,sc27xx-pd", "sprd,sc2730-pd";
						reg = <0xe00 0x380>;
						interrupt-parent = <0x7d>;
						interrupts = <0x09 0x04>;
						extcon = <0x1c>;
						nvmem-cells = <0x86 0x87 0x88 0x7e>;
						nvmem-cell-names = "pdrc_calib", "pddelta_calib", "pdref_calib", "cc_calib";
						status = "disabled";
						phandle = <0x164>;

						usb_con: connector {
							compatible = "usb-c-connector";
							label = "USB-C";
							power-role = "dual";
							try-power-role = "sink";
							source-pdos = <0x4019028>;
							sink-pdos = <0x4019032 0x40190c8>;
							op-sink-microwatt = <0x989680>;
							phandle = <0x165>;
						};
					};

					sprd_audio_codec_ana: audio-codec@1000 {
						compatible = "sprd,sc2730-audio-codec", "sprd,sc27xx-audio-codec";
						#sound-dai-cells = <0x01>;
						reg = <0x1000>;
						sprd,syscon-pmu-apb = <0x02>;
						nvmem-cells = <0x89 0x8a 0x84>;
						nvmem-cell-names = "aud_pabst_vcal_efuse", "neg_cp_efuse", "fgu_4p2_efuse";
						status = "okay";
						hp-use-inter-pa = <0x01>;
						fixed-sample-rate = <0xbb80 0xbb80 0xbb80>;
						digital-codec = <0x8b>;
						phandle = <0x11f>;
					};

					syscon@1800 {
						compatible = "sprd,sc27xx-syscon";
						reg = <0x1800 0x1ba0 0x1b98>;
					};

					power-controller@1800 {
						compatible = "sprd,sc27xx-regulator", "sprd,sc2730-regulator";

						vddcpu: DCDC_CPU {
							regulator-name = "vddcpu";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x166>;
						};

						vddgpu: DCDC_GPU {
							regulator-name = "vddgpu";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x08>;
						};

						vddcore: DCDC_CORE {
							regulator-name = "vddcore";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x167>;
						};

						vddmodem: DCDC_MODEM {
							regulator-name = "vddmodem";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x168>;
						};

						vddmem: DCDC_MEM {
							regulator-name = "vddmem";
							regulator-min-microvolt = <0x61a80>;
							regulator-max-microvolt = <0x185196>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x169>;
						};

						vddmemq: DCDC_MEMQ {
							regulator-name = "vddmemq";

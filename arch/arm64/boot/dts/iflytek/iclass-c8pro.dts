	memory: memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000>;
		phandle = <0x124>;
	};

	chosen {
		stdout-path = "/soc/ap-apb/serial@70100000";
		bootargs = "earlycon=sprd_serial,0x70100000,115200n8 console=ttyS1,115200n8 loglevel=8 no_console_suspend initcall_debug init=/init root=/dev/mmcblk0p30 rootfstype=ext4 ro rootwait androidboot.hardware=ud710_21c10 androidboot.dtbo_idx=0 printk.devkmsg=on pcie_ports=compat dyndbg=\"file drivers/of/platform.c +p; file drivers/base/dd.c +p\"";
	};

	ipi: interrupt-controller {
		compatible = "android,CustomIPI";
		#interrupt-cells = <0x01>;
		interrupt-controller;
		phandle = <0x123>;
	};

	trusty {
		compatible = "sprd,trusty-smc-v1";

		irq {
			compatible = "sprd,trusty-irq-v1";
			/* 5.15 maps Trusty SGIs through GICv3. */
			interrupt-templates = <&gic 0 0 0>, <&gic 1 1 8>, <&gic 1 0 4>;
			interrupt-ranges = <0x00 0x0f 0x00 0x10 0x1f 0x01 0x20 0xdf 0x02>;
		};

		virtio {
			compatible = "sprd,trusty-virtio-v1";
		};

		log {
			compatible = "sprd,roc1-trusty-log-v1";
		};
	};

	sprd-sysdump {
		memory-region = <0x124>;
		memory-region-re = <0x125 0x126 0x127>;
	};

	bcmdhd {
		compatible = "android,bcmdhd_wlan";
		wl_reg_on_gpio = <0x2d 0x4d 0x00>;
		wl_host_wake_gpio = <0x2d 0x45 0x00>;
		sprd,rc-ctrl = <0x128>;
	};

	bt_sleep {
		compatible = "bcm,bluesleep";
		bcm,bt-host-wake-gpio = <0x2d 0x7b 0x00>;
		bcm,bt-wake-gpio = <0x2d 0x36 0x00>;
		status = "disabled";
	};

	bt-dev {
		compatible = "iflytek,c8pro-bt-control";
		status = "okay";
		reset-gpios = <0x2d 0x7e 0x00>;
		device-wake-gpios = <0x2d 0x36 0x00>;
		host-wake-gpios = <0x2d 0x7b 0x00>;
	};

	sprd-wlan {
		compatible = "sprd,sc2355-wifi";
		reg = <0x00 0x21040064 0x00 0x0a 0x00 0x211c0000 0x00 0x3000>;
		reg-names = "wifi_ipaqos", "pam_wifi_reg_base_remap";
		syscons = <0x16 0x04 0x40>;
		syscon-names = "enable";
	};

	bat: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x694920>;
		charge-term-current-microamp = <0x2bf20>;
		constant_charge_voltage_max_microvolt = <0x419ce0>;
		factory-internal-resistance-micro-ohms = <0x101d0>;
		factory-internal-resistance-micro-ohms1 = <0x14438>;
		voltage-min-design-microvolt = <0x34a490>;
		ocv-capacity-celsius = <0x14>;
		ocv-capacity-table-0 = <0x410c58 0x64 0x403d50 0x5f 0x3f7a00 0x5a 0x3eb6b0 0x55 0x3e2df8 0x50 0x3d7660 0x4b 0x3cd250 0x46 0x3c3de0 0x41 0x3b6708 0x3c 0x3aea08 0x37 0x3a8c48 0x32 0x3a4210 0x2d 0x3a0390 0x28 0x39d0c8 0x23 0x399a18 0x1e 0x395b98 0x19 0x391930 0x14 0x38afb8 0x0f 0x3859c8 0x0a 0x37f050 0x05 0x33e140 0x00>;

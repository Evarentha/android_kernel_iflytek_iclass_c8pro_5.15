/dts-v1/;

#include <dt-bindings/clock/sprd,roc1-clk.h>

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	cpuinfo_hardware = "Unisoc UD710";
	/* Temporary boot-visible build tag: shows in the log line
	 * "Machine model: ..." so the flashed DTB revision is verifiable. */
	model = "iFLYTEK iClass C8Pro (dtb-v46-ksunext1)";
	compatible = "iflytek,iclass-c8pro", "sprd,ud710";
	sprd,sc-id = <0x2c6 0x01 0x20000>;

	/* U-Boot clamps this runtime request to its compiled log-level maximum. */
	mitochodria,uboot-log-level = <0x02>;

	qos {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		ranges;

		gpu_qos: qos@0 {
			reg = <0x00>;
			arqos-gpu0 = [06];
			awqos-gpu0 = [06];
			arqos-threshold-gpu0 = [0f];
			awqos-threshold-gpu0 = [0f];
			arqos-gpu1 = [06];
			awqos-gpu1 = [06];
			arqos-threshold-gpu1 = [0f];
			awqos-threshold-gpu1 = [0f];
			phandle = <0x0b>;
		};

		dpu_qos: qos@1 {
			reg = <0x01>;
			awqos-high = [0a];
			awqos-low = [0a];
			arqos-high = [0d];
			arqos-low = [0c];
			arqos-threshold = [0c];
			awqos-threshold = [0f];
			phandle = <0x1f>;
		};

		vsp_qos: qos@2 {
			reg = <0x02>;
			awqos = [01];
			arqos-high = [07];
			arqos-low = [01];
			phandle = <0x34>;
		};

		ai_qos: qos@3 {
			reg = <0x03>;
			arqos-threshold-ai = [0f];
			awqos-threshold-ai = [0f];
			arqos-powervr = [06];
			awqos-powervr = [06];
			arqos-cambricon = [06];
			awqos-cambricon = [06];
			phandle = <0xb2>;
		};

		ese_qos: qos@4 {
			reg = <0x04>;
			awqos-axi = [05];
			arqos-axi = [05];
			phandle = <0x129>;
		};

		mm {

			dcam_qos: qos@0 {
				reg = <0x00>;
				arqos = [0b];
				awqos-high = [0d];
				awqos-low = [0b];
				phandle = <0x12a>;
			};

			isp_qos: qos@1 {
				reg = <0x01>;
				awqos-high = [0a];
				awqos-low = [08];
				arqos-high = [0a];
				arqos-low = [08];
				phandle = <0x12b>;
			};

			cpp_qos: qos@2 {
				reg = <0x02>;
				awrqos = [01];
				phandle = <0x12c>;
			};

			fd_qos: qos@3 {
				reg = <0x03>;
				arqos = [01];
				awqos = [01];
				phandle = <0x12d>;
			};

			jpg_qos: qos@4 {
				reg = <0x04>;
				arqos-high = [07];
				arqos-low = [01];
				awqos = [01];
				phandle = <0x12>;
			};

			mm_qos_threshold: qos@5 {
				reg = <0x05>;
				arqos-threshold = [0d];
				awqos-threshold = [0d];
				phandle = <0x12e>;
			};
		};

		ap {

			ap_qos0: qos@0 {
				reg = <0x00>;
				arqos-vdsp = [05];
				awqos-vdsp = [05];
				arqos-ce = [05];
				awqos-ce = [05];
				arqos-dma = [05];
				awqos-dma = [05];
				arqos-ufs = [06];
				awqos-ufs = [06];
				phandle = <0x12f>;
			};

			ap_qos1: qos@1 {
				reg = <0x01>;
				arqos-sdio0 = [05];
				awqos-sdio0 = [05];
				arqos-sdio1 = [05];
				awqos-sdio1 = [05];
				arqos-sdio2 = [05];
				awqos-sdio2 = [05];
				arqos-emmc = [05];
				awqos-emmc = [05];
				phandle = <0x130>;
			};

			ap_qos_threshold: qos@2 {
				reg = <0x02>;
				arqos-threshold-main = [05];
				awqos-threshold-main = [05];
				arqos-threshold-merge = [06];
				awqos-threshold-merge = [06];
				arqos-threshold-vdsp = [0a];
				awqos-threshold-vdsp = [0a];
				phandle = <0x131>;
			};
		};

		ipa {

			mtx_qos_0: qos@0 {
				reg = <0x00>;
				arqos-m0 = [09];
				awqos-m0 = [09];
				arqos-m1 = [09];
				awqos-m1 = [09];
				arqos-m2 = [09];
				awqos-m2 = [09];
				arqos-m3 = [09];
				awqos-m3 = [09];
				phandle = <0x132>;
			};

			mtx_qos_1: qos@1 {
				reg = <0x01>;
				arqos-m4 = [09];
				awqos-m4 = [09];
				arqos-m5 = [09];
				awqos-m5 = [09];
				arqos-m6 = [09];
				awqos-m6 = [09];
				arqos-m7 = [09];
				awqos-m7 = [09];
				phandle = <0x133>;
			};

			misc_cfg: qos@2 {
				reg = <0x02>;
				arqos-threshold-ipa1 = [0c];
				awqos-threshold-ipa1 = [0c];
				arqos-threshold-ipa2 = [0c];
				awqos-threshold-ipa2 = [0c];
				phandle = <0x134>;
			};
		};
	};

	aliases {
		i2c0 = "/soc/ap-apb/i2c@70300000";
		i2c1 = "/soc/ap-apb/i2c@70400000";
		i2c2 = "/soc/ap-apb/i2c@70500000";
		i2c3 = "/soc/ap-apb/i2c@70600000";
		i2c4 = "/soc/ap-apb/i2c@70700000";
		i2c5 = "/soc/aon/i2c@32060000";
		i2c6 = "/soc/aon/i2c@32370000";
		spi0 = "/soc/ap-apb/spi@70800000";
		spi1 = "/soc/ap-apb/spi@70900000";
		spi2 = "/soc/ap-apb/spi@70a00000";
		spi3 = "/soc/ap-apb/spi@70b00000";
		eth0 = "/sipa-eth0";
		eth1 = "/sipa-eth1";
		eth2 = "/sipa-eth2";
		eth3 = "/sipa-eth3";
		eth4 = "/sipa-eth4";
		eth5 = "/sipa-eth5";
		eth6 = "/sipa-eth6";
		eth7 = "/sipa-eth7";
		thm-sensor15 = "/soc/aon/cluster0-sensor@15";
		thm-sensor16 = "/soc/aon/cluster1-sensor@16";
		thm-sensor17 = "/soc/aon/soc-sensor@17";
		cooling-device0 = "/cooling-devices/cluster0-cooling";
		cooling-device1 = "/cooling-devices/cluster1-cooling";
		gpu-cooling0 = "/gpu-cooling-devices/gpu-cooling0";
		lte-modem0 = "/modem@0";
		nr-modem0 = "/modem@1";
		nr-modem1 = "/modem@2";
		serial0 = "/soc/ap-apb/serial@70000000";
		serial1 = "/soc/ap-apb/serial@70100000";
		serial2 = "/soc/ap-apb/serial@70200000";
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x135>;

		ap_ahb_regs: syscon@20100000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x20100000 0x00 0x10000>;
			phandle = <0x1d>;
		};

		ipa_ahb_regs: syscon@21040000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x21040000 0x00 0x10000>;
			phandle = <0x16>;
		};

		pub_apb_regs: syscon@31050000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x31050000 0x00 0x10000>;
			phandle = <0x8e>;
		};

		aon_apb_regs: syscon@32090000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32090000 0x00 0x10000>;
			phandle = <0x10>;
		};

		pmu_apb_regs: syscon@32280000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32280000 0x00 0x10000>;
			phandle = <0x02>;
		};

		ap_intc0_regs: syscon@32310000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32310000 0x00 0x10000>;
			phandle = <0xef>;
		};

		ap_intc1_regs: syscon@32320000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32320000 0x00 0x10000>;
			phandle = <0xf0>;
		};

		ap_intc2_regs: syscon@32330000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32330000 0x00 0x10000>;
			phandle = <0xf1>;
		};

		ap_intc3_regs: syscon@32340000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32340000 0x00 0x10000>;
			phandle = <0xf2>;
		};

		ap_intc4_regs: syscon@32350000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32350000 0x00 0x10000>;
			phandle = <0x38>;
		};

		ap_intc5_regs: syscon@32360000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32360000 0x00 0x10000>;
			phandle = <0xf3>;
		};

		anlg_phy_g0_regs: syscon@32390000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32390000 0x00 0x10000>;
			phandle = <0x136>;
		};

		anlg_phy_g2_regs: syscon@323a0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323a0000 0x00 0x8000>;
			phandle = <0x137>;
		};

		anlg_phy_g3_regs: syscon@323b0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323b0000 0x00 0x4000>;
			phandle = <0x19>;
		};

		anlg_phy_g1_regs: syscon@323b4000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323b4000 0x00 0x4000>;
			phandle = <0x9f>;
		};

		anlg_phy_g4_regs: syscon@323c0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323c0000 0x00 0x10000>;
			phandle = <0x78>;
		};

		anlg_phy_g5_regs: syscon@323d0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323d0000 0x00 0x4000>;
			phandle = <0xb6>;
		};

		anlg_phy_g15_regs: syscon@323d4000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323d4000 0x00 0xc000>;
			phandle = <0x138>;
		};

		anlg_phy_g11_regs: syscon@323e0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323e0000 0x00 0x4000>;
			phandle = <0x139>;
		};

		anlg_phy_g16_regs: syscon@323e4000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323e4000 0x00 0x4000>;
			phandle = <0x13a>;
		};

		anlg_phy_g19_regs: syscon@323e8000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323e8000 0x00 0x8000>;
			phandle = <0x13b>;
		};

		anlg_phy_g10_regs: syscon@323f0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x323f0000 0x00 0x10000>;
			phandle = <0x0e>;
		};

		anlg_phy_g8_regs: syscon@32400000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32400000 0x00 0x4000>;
			phandle = <0x13c>;
		};

		anlg_phy_g13_regs: syscon@32404000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32404000 0x00 0x4000>;
			phandle = <0x39>;
		};

		anlg_phy_g14_regs: syscon@32408000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32408000 0x00 0x4000>;
			phandle = <0x13d>;
		};

		anlg_pcie20_phy_regs: syscon@3240c000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x3240c000 0x00 0x4000>;
			phandle = <0x3a>;
		};

		anlg_phy_g9_regs: syscon@32410000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32410000 0x00 0x4000>;
			phandle = <0x79>;
		};

		anlg_phy_g12_regs: syscon@32414000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32414000 0x00 0x4000>;
			phandle = <0x13e>;
		};

		anlg_phy_g17_regs: syscon@32418000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32418000 0x00 0x4000>;
			phandle = <0x77>;
		};

		anlg_phy_g18_regs: syscon@3241c000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x3241c000 0x00 0x4000>;
			phandle = <0x13f>;
		};

		anlg_phy_top_regs: syscon@32420000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32420000 0x00 0x4000>;
			phandle = <0x1a>;
		};

		anlg_phy_top1_regs: syscon@32424000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32424000 0x00 0x4000>;
			phandle = <0x0d>;
		};

		anlg_phy_g6_regs: syscon@32434000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32434000 0x00 0x4000>;
			phandle = <0x36>;
		};

		anlg_pcie30_phy_regs: syscon@32438000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x32438000 0x00 0x4000>;
			phandle = <0x140>;
		};

		audcp_apb_regs: syscon@0x3350d000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x3350d000 0x00 0x10000>;
			phandle = <0xb7>;
		};

		audcp_ahb_regs: syscon@0x335e0000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x335e0000 0x00 0x10000>;
			phandle = <0xa2>;
		};

		gpu_apb_regs: syscon@60100000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x60100000 0x00 0x10000>;
			phandle = <0x09>;
		};

		gpu_dvfs_apb_regs: syscon@60110000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x60110000 0x00 0x10000>;
			phandle = <0x0a>;
		};

		mm_ahb_regs: syscon@62200000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x62200000 0x00 0x100000>;
			phandle = <0x03>;
		};

		ai_apb_regs: syscon@6fd00000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x6fd00000 0x00 0x4000>;
			phandle = <0xb1>;
		};

		ap_apb_regs: syscon@71000000 {
			compatible = "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x71000000 0x00 0x100000>;
			phandle = <0x9a>;
		};

		mm {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			mm_domain: mm-domain {
				compatible = "sprd,mm-domain";
				syscon-names = "force_shutdown", "shutdown_en", "power_state", "qos_ar", "qos_aw";
				syscons = <0x02 0x24 0x2000000 0x02 0x24 0x1000000 0x02 0x588 0xff000000 0x03 0x0c 0xf0 0x03 0x0c 0x0f>;
				clock-names = "mm_eb", "mm_ahb_eb", "clk_mm_ahb", "clk_mm_ahb_parent", "mm_mtx_eb", "clk_mm_mtx", "clk_mm_mtx_parent", "clk_isppll";
				clocks = <0x04 0x08 0x05 0x07 0x06 0x00 0x07 0x0f 0x05 0x08 0x06 0x01 0x07 0x08 0x07 0x1b>;
				phandle = <0x141>;
			};

			gpu: gpu@60000000 {
				compatible = "sprd,rogue";
				reg = <0x00 0x60000000 0x00 0x100000>;
				gpu-supply = <0x08>;
				syscons = <0x02 0x30 0x2000000 0x02 0x28 0x2000000 0x02 0x28 0x1000000 0x09 0x34 0x01 0x09 0x10 0x1ffff 0x09 0x28 0x1ffff 0x0a 0x8c 0x07 0x0a 0x20 0x171 0x0a 0x3c 0x01>;
				syscon-names = "top_force_shutdown", "rgx_dust_force_shutdown", "rgx_dust_auto_shutdown", "cgm_gpu_dvfs_en", "gpu0_qos", "gpu1_qos", "dvfs_index_cfg", "sw_dvfs_ctrl", "pdvfs_cfg";
				interrupts = <0x00 0x3c 0x04>;
				operating-points = <0x5dc00 0xaae60 0x7d000 0xb71b0 0x96000 0xb71b0 0xbb800 0xc3500 0xc3500 0xc3500>;
				sprd,dvfs-lists = <0x5dc00 0xaae60 0x06 0x01 0x7d000 0xb71b0 0x07 0x01 0x96000 0xb71b0 0x08 0x01 0xbb800 0xc3500 0x09 0x01 0xc3500 0xc3500 0x0a 0x01>;
				sprd,dvfs-default = <0x00>;
				sprd,qos = <0x0b>;
				sprd,dvfs-scene-extreme = <0x02>;
				sprd,dvfs-scene-high = <0x01>;
				sprd,dvfs-scene-medium = <0x01>;
				sprd,dvfs-scene-low = <0x00>;
				sprd,dvfs-range-max = <0x02>;
				sprd,dvfs-range-min = <0x00>;
				clocks = <0x04 0x0a 0x0c 0x00 0x0c 0x01 0x0c 0x02 0x0c 0x03 0x0c 0x04 0x07 0x02 0x07 0x08 0x07 0x15 0x07 0x01 0x07 0x18>;
				phandle = <0x142>;
			};

			mipi_csi_phy: mipi-csi-phy {
				compatible = "sprd,mipi-csi-phy";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				ranges;
				status = "okay";
				phandle = <0x143>;

				csi_phy0: phy@0 {
					syscons = <0x0d 0x08 0x800 0x0d 0x08 0x400 0x0d 0x08 0x200>;
					syscon-names = "iso_sw_en", "ps_pd_s", "ps_pd_l";
					reg = <0x00>;
					sprd,phyname = "4lane_0";
					sprd,project-id = <0x01>;
					sprd,cam-ahb-syscon = <0x03>;
					status = "okay";
					phandle = <0x144>;
				};

				csi_phy1: phy@1 {
					syscons = <0x0d 0x08 0x800000 0x0e 0x08 0x10 0x0d 0x08 0x200000 0x0d 0x08 0x400000>;
					syscon-names = "iso_sw_en", "csi_mode_sel", "ps_pd_l", "ps_pd_s";
					reg = <0x01>;
					sprd,project-id = <0x01>;
					sprd,phyname = "2p2";
					sprd,cam-ahb-syscon = <0x03>;
					status = "okay";
					phandle = <0x145>;
				};

				csi_phy3: phy@3 {
					syscons = <0x0d 0x08 0x800000 0x0e 0x0c 0x10 0x0d 0x08 0x200000 0x0d 0x08 0x400000>;
					syscon-names = "iso_sw_en", "csi_mode_sel", "ps_pd_l", "ps_pd_s";
					reg = <0x03>;
					sprd,project-id = <0x01>;
					sprd,phyname = "2p2_m";
					sprd,cam-ahb-syscon = <0x03>;
					status = "okay";
					phandle = <0x146>;
				};

				csi_phy4: phy@4 {
					syscons = <0x0d 0x08 0x800000 0x0e 0x0c 0x10 0x0d 0x08 0x200000 0x0d 0x08 0x400000>;
					syscon-names = "iso_sw_en", "csi_mode_sel", "ps_pd_l", "ps_pd_s";
					reg = <0x04>;
					sprd,project-id = <0x01>;
					sprd,phyname = "2p2_s";
					sprd,cam-ahb-syscon = <0x03>;
					status = "okay";
					phandle = <0x147>;
				};

				csi_phy5: phy@5 {
					syscons = <0x0d 0x08 0x20000 0x0d 0x08 0x10000 0x0d 0x08 0x8000>;
					syscon-names = "iso_sw_en", "ps_pd_s", "ps_pd_l";
					reg = <0x05>;
					sprd,project-id = <0x01>;
					sprd,phyname = "4lane_1";
					sprd,cam-ahb-syscon = <0x03>;
					status = "okay";
					phandle = <0x148>;
				};
			};

			isp: isp@62000000 {
				compatible = "sprd,isp";
				reg = <0x00 0x62000000 0x00 0x100000>;
				interrupts = <0x00 0x2b 0x04 0x00 0x2c 0x04>;
				interrupts_name = "ispch0", "ispch1";
				clock-names = "isp_eb", "isp_axi_eb", "isp_clk", "isp_clk_256m", "isp_clk_307m2", "isp_clk_384m", "isp_clk_468m", "isp_clk_512m", "isp_clk_parent";
				clocks = <0x05 0x03 0x05 0x08 0x06 0x0a 0x07 0x09 0x07 0x0c 0x07 0x02 0x07 0x1b 0x07 0x08 0x07 0x08>;
				syscons = <0x03 0x04 0x400 0x03 0x04 0x1000>;
				syscon-names = "reset", "isp_ahb_reset";
				sprd,cam-ahb-syscon = <0x03>;
				sprd,isp-count = <0x01>;
				iommus = <0x0f>;
				status = "okay";
				phandle = <0x14>;
			};

			iommu_isp: iommu@62000000 {
				compatible = "unisoc,iommuexroc1-isp";
				reg = <0x00 0x62000000 0x00 0xffc00 0x00 0x620ffc00 0x00 0x400>;

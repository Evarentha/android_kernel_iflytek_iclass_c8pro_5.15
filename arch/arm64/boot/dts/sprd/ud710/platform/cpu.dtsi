			1716000 950000
			1534000 893750
			1482000 878125
			1228800 800000
			1144000 775000
			962000  750000
			768000  750000
			614400  750000
		>;

		operating-points-4 = <
			/*kHZ	uV*/
			1820000 1000000
			1716000 996875
			1534000 937500
			1482000 921875
			1228800 843750
			1144000 815625
			962000  759375
			768000  750000
			614400  750000
		>;

	};


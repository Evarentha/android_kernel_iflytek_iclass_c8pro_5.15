	cpufreq_scu: cpufreq-scu {
		cpufreq-cluster-id = <2>;
		clock-latency = <50000>;
		voltage-latency = <0>;
		nvmem-cells = <&scu_bin>;
		nvmem-cell-names = "dvfs_bin";

		operating-points = <

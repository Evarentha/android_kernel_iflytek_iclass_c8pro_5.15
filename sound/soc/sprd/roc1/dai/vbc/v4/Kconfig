config SND_SOC_SPRD_VBC_V4
	tristate "VBC V4"
	depends on SPRD_AUDIO_MCDT && SPRD_AUDIO_SIPC
	help
	  If the chip is the series of sharkl5,
	  set Y or M, else N.

config MITOCHODRIA_VBC_LEGACY_ABI
	bool "Mitochodria legacy Android 9 audio DSP protocol"
	depends on SND_SOC_SPRD_VBC_V4
	help
	  Use the 616-byte startup/shutdown layout and unshifted DMIC
	  selection expected by the legacy 4.14.98 audio firmware.
	  Select this only when using that firmware and its Android 9 HAL.
	  Other boards retain the newer VBC startup protocol by default.

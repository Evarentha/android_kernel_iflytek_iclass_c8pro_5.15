#
# SPRD Sensor Hub drivers configuration
#

menu "Spreadtrum Sensor Hub"

config SPRD_SENSOR_HUB
	tristate "Spreadtrum Sensor Hub"
	select IIO_BUFFER
	select IIO_KFIFO_BUF
	select IIO_TRIGGER
	depends on SPRD_SYSTIMER
	depends on UNISOC_SIPC
	help
	  Support Sensor hub Feature
	  Provide power saving solution for integrating and
	  processing sensor data.

	  Say Y here to build support for sensor hub.
	  To compile this driver as a module, choose M here

config MITOCHODRIA_SENSOR_HUB_LEGACY
	bool "Mitochodria legacy Android 9 SensorHub protocol"
	depends on SPRD_SENSOR_HUB
	help
	  Restore the opcode download and tagged event ABI used by the
	  legacy CM4 firmware and Android 9 sensor HAL.

config MITOCHODRIA_CM4_LOADER
	bool "Mitochodria ROC1 CM4 userspace loader interface"
	depends on ARCH_SPRD && OF && PROC_FS && MFD_SYSCON
	help
	  Expose DT-described CM4 memory segments to the userspace Trusty
	  firmware loader. Firmware authentication remains owned by the TEE.

endmenu
